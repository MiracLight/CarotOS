#!/bin/sh
# /etc/grub.d/99_carotos_sure -- GRUB menu bekleme suresi (CarotOS karari):
#   yalnizca CarotOS kuruluysa  -> 5 sn
#   baska isletim sistemi varsa -> 30 sn (kullanici secim yapabilsin)
# os-prober'i BU BETIK CALISTIRMAZ: 30_os-prober update-grub sirasinda onu zaten bir kez calistirir
# (takili medyayi root olarak baglayan tarama yalniz bir kez yapilsin diye). 99, 30'dan SONRA calisir;
# grub-mkconfig butun betiklerin ciktisini grub.cfg.new dosyasina yazar (bu betigin standart ciktisi
# o dosyadir), 30_os-prober'in orada biraktigi "osprober-" kimlikli menuentry satirlari sayilir.
# Standart cikti bir dosya degilse (elle calistirma, boru) ya da okunamazsa baska sistem yok sayilir (5 sn).
# Cikti grub.cfg'ye en sona eklenir, bu yuzden 00_header'daki "set timeout=" degerini ezer.
# GRUB_DISABLE_OS_PROBER=false degilse 30_os-prober bir sey uretmez, baska sistem aranmaz (5 sn).
set -e

SURE_TEK=${CAROT_SURE_TEK:-5}
SURE_COK=${CAROT_SURE_COK:-30}

diger=0
cikti=$(readlink "/proc/$$/fd/1" 2>/dev/null || true)
if [ "${GRUB_DISABLE_OS_PROBER:-true}" = "false" ] && [ -n "$cikti" ] && [ -f "$cikti" ] && [ -r "$cikti" ]; then
    diger=$(grep -cE "^[[:space:]]*(menuentry|submenu)[[:space:]].*osprober-" "$cikti" 2>/dev/null || true)
fi

if [ "${diger:-0}" -gt 0 ] 2>/dev/null; then
    sure=$SURE_COK
else
    sure=$SURE_TEK
    diger=0
fi

cat <<EOF
# CarotOS: baska isletim sistemi girisi: $diger -> menu bekleme suresi $sure sn
set timeout=$sure
EOF
