[Unit]
Description=CarotOS ilk acilis ayarlari
# Grup uyelikleri ilk oturum acilmadan once verilmeli (yoksa tshark ilk
# oturumda "Couldn't run dumpcap" verir): oturum aciliminden once siralanir.
After=local-fs.target
Before=display-manager.service systemd-user-sessions.service
ConditionPathExists=!/var/lib/carotos/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/carotos-firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
