<?xml version="1.1" encoding="UTF-8"?>

<!--
  CarotOS masaustu yapilandirmasi.

  DIKKAT: Buraya monitore ozgu duvar kagidi ayari YAZILMAZ.

  xfdesktop duvar kagidini monitorun baglanti adina gore sakliyor
  (monitorLVDS-1, monitoreDP-1, monitorVirtual1...). Bu ad makineden
  makineye degisiyor ve adlandirma kurali surumler arasinda tutarli
  degil. Sabit bir ad yazmak, sadece o adin yakalandigi makinede
  calisir; digerlerinde duvar kagidi kayboluyor.

  Duvar kagidi bunun yerine ilk oturumda
  /usr/local/bin/carotos-desktop-init tarafindan, makinede gercekten
  hangi monitor varsa ona gore ayarlaniyor.
-->

<channel name="xfce4-desktop" version="1.0">
  <property name="last-settings-migration-version" type="uint" value="1"/>

  <property name="backdrop" type="empty">
    <!-- Tum calisma alanlarinda ayni duvar kagidi -->
    <property name="single-workspace-mode" type="bool" value="true"/>
    <property name="single-workspace-number" type="int" value="0"/>
  </property>

  <property name="desktop-menu" type="empty">
    <property name="show" type="bool" value="true"/>
  </property>

  <property name="windowlist-menu" type="empty">
    <property name="show" type="bool" value="true"/>
    <property name="show-add-remove-workspaces" type="bool" value="true"/>
  </property>
</channel>
