#!/usr/bin/python3 -I
# -*- coding: utf-8 -*-
"""
CarotPot yonetici yardimcisi. Arayuz bunu pkexec ile cagirir.

Yalnizca sabit komutlar calistirir; disaridan gelen tek veri IP adresi ve
ayar JSON'udur, ikisi de ipaddress/ayar_dogrula ile dogrulanir ve komutlara
liste argumani olarak verilir (kabuk yok).

  carotpot-yonet baslat            hizmeti baslatir (ufw izinlerini birimin
                                   ExecStartPost'u acar: izin-ac)
  carotpot-yonet durdur            hizmeti durdurur, acilan portlari kapatir
  carotpot-yonet izin-ac           (birim, root) hizmetin GERCEKTEN actigi
                                   portlara ufw izni verir; varsayilan kapsam
                                   yalnizca ozel ag adres bloklari
  carotpot-yonet izin-kapat        (birim, root) CarotPot'un ekledigi izinleri siler
  carotpot-yonet izin-temizle      (acilis) hizmet calismiyorsa kalmis izinleri siler
  carotpot-yonet ayar              stdin'den ayar JSON'u okur ve kaydeder
  carotpot-yonet engelle IP [DK]   IP'yi ufw ile engeller (onayli eylem, D8);
                                   DK verilirse engel o kadar dakika surer
  carotpot-yonet kaldir IP         engeli kaldirir
  carotpot-yonet sure-denetle      suresi dolan engelleri kaldirir (zamanlayici
                                   ve acilistaki temizlik birimi cagirir)
  carotpot-yonet parolalar IP      bu kaynagin denedigi parolalari (maskesiz)
                                   dondurur; arayuzdeki "Goster" icin
  carotpot-yonet otomatik ac|kapat fail2ban ile otomatik engellemeyi acar/kapatir

Cikti tek satir JSON: {"kod": "__TAMAM__", ...}
"""

import importlib.util
import json
import os
import sqlite3
import subprocess
import sys
import time

BURASI = os.path.dirname(os.path.abspath(__file__))
_spec = importlib.util.spec_from_file_location(
    "carotpot", os.path.join(BURASI, "carotpot.py"))
CP = importlib.util.module_from_spec(_spec)
sys.dont_write_bytecode = True
_spec.loader.exec_module(CP)
KENDISI = os.path.abspath(__file__)

AYAR = CP.AYAR_DOSYASI
ACILAN = "/etc/carotpot/acilan_portlar.json"
# Root'a ait dizin. /var/log/carotpot, carotpot hizmet kullanicisinin dizinidir
# (LogsDirectory=); orada root'un okuyup yazdigi dosya sembolik bagla
# yonlendirilebilirdi.
ENGELLILER = "/var/lib/carotos/carotpot/engelliler.json"
JAIL = "/etc/fail2ban/jail.d/carotos-carotpot.local"
DURUM = CP.DURUM_DOSYASI
HIZMET = "carotpot.service"
ORTAM = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C", "LANG": "C"}


def _sistem_yolu_yukle():
    """Root olarak calisacak programlar yalnizca sistem dizinlerinde aranir
    (ortak/yetkili.py). -I ile calistigimiz icin dosyadan yuklenir; ortak/
    yoksa ayni kural yerel olarak uygulanir."""
    yol = os.path.join(os.path.dirname(BURASI), "ortak", "yetkili.py")
    try:
        spec = importlib.util.spec_from_file_location("carotos_yetkili", yol)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod.sistem_yolu
    except (OSError, ImportError, AttributeError):
        def sistem_yolu(ad):
            if not isinstance(ad, str) or not ad or "/" in ad or ad.startswith("-"):
                return None
            for dizin in ("/usr/sbin", "/usr/bin", "/sbin", "/bin"):
                tam = os.path.join(dizin, ad)
                if os.path.isfile(tam) and os.access(tam, os.X_OK):
                    return tam
            return None
        return sistem_yolu


sistem_yolu = _sistem_yolu_yukle()


def cikis(kod, **ek):
    print(json.dumps(dict(kod=kod, **ek), ensure_ascii=False))
    sys.exit(0 if kod == "__TAMAM__" else 1)


def calistir(komut, zaman=60):
    # Komutlar duz adla yazilir; tam yol PATH'e bakilmadan cozulur
    tam = komut[0] if os.path.isabs(komut[0]) else sistem_yolu(komut[0])
    if tam is None:
        return 127, f"{komut[0]}: bulunamadi"
    try:
        p = subprocess.run([tam] + list(komut[1:]), stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT,
                           text=True, errors="replace", timeout=zaman, env=ORTAM)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired) as hata:
        return 127, str(hata)


def json_oku(yol, varsayilan):
    try:
        with open(yol, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return varsayilan


def json_yaz(yol, veri, mod=0o644):
    os.makedirs(os.path.dirname(yol), exist_ok=True)
    gecici = "%s.%d.yeni" % (yol, os.getpid())
    # O_EXCL | O_NOFOLLOW: onceden birakilmis dosya ya da sembolik bag varsa
    # hata verir, takip etmez; izin dosya betimleyicisiyle verilir.
    bayrak = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(gecici, bayrak, mod)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(veri, fh, ensure_ascii=False, indent=1)
            fh.flush()
            os.fchmod(fh.fileno(), mod)
        os.replace(gecici, yol)
    except BaseException:
        try:
            os.unlink(gecici)
        except OSError:
            pass
        raise


# --- ag bilgisi: kendini kilitleme korumasi ---------------------------------

def korunan_adresler():
    """Hicbir kosulda engellenmeyecek adresler: kendi adreslerimiz, ag
    gecitleri, geri dongu ve kullanicinin yoksay listesi."""
    adresler = {"127.0.0.1", "::1"}
    kod, cikti = calistir(["ip", "-j", "addr"])
    if kod == 0:
        try:
            for arayuz in json.loads(cikti):
                for a in arayuz.get("addr_info", []):
                    if a.get("local"):
                        adresler.add(str(CP.adres_coz(a["local"]) or a["local"]))
        except ValueError:
            pass
    for aile in ("-4", "-6"):
        kod, cikti = calistir(["ip", aile, "-j", "route", "show", "default"])
        if kod == 0:
            try:
                for rota in json.loads(cikti):
                    if rota.get("gateway"):
                        adresler.add(str(CP.adres_coz(rota["gateway"]) or rota["gateway"]))
            except ValueError:
                pass
    adresler.update(CP.ayar_oku(AYAR)["yoksay"])
    return adresler


def engel_adresi_dogrula(ham):
    adr = CP.adres_coz(ham)
    if adr is None or adr.is_unspecified or adr.is_multicast or adr.is_loopback:
        cikis("__GECERSIZ_IP__")
    if str(adr) in korunan_adresler():
        cikis("__KORUNAN_ADRES__", ip=str(adr))
    return str(adr)


# --- ufw ------------------------------------------------------------------------

def ufw_aktif():
    kod, cikti = calistir(["ufw", "status"])
    return kod == 0 and "Status: active" in cikti


def izin_kaynaklari(ayar):
    """ufw izninin kaynak bloklari. Varsayilan (yalnizca yerel ag): tuzagin
    kabul ettigi ozel adres bloklari (geri dongu haric; ufw onu zaten kabul
    eder). internet_kabul acikken [None] = her adres (C-02 karari)."""
    if ayar.get("internet_kabul"):
        return [None]
    return [str(n) for n in CP.YEREL_AGLAR if not n.is_loopback]


def izin_komutu(port, kaynak):
    port = int(port)
    if kaynak is None:
        return [f"{port}/tcp"]
    return ["from", kaynak, "to", "any", "port", str(port), "proto", "tcp"]


def kural_eklendi_mi(kod, cikti):
    """ufw yinelenen kurala da 0 doner ("Skipping adding existing rule") ve
    yorumu farkli ayni kurali "Rule updated" ile gunceller: ikisinde de kural
    kullanicinindir, CarotPot'un sayilmaz (durdur ona dokunmamali)."""
    return (kod == 0 and ("Rule added" in cikti or "Rule inserted" in cikti)
            and "Skipping" not in cikti and "updated" not in cikti)


def portlari_ac(portlar, ayar=None):
    """Verilen portlara ufw izni ekler; yalnizca GERCEKTEN eklenen kurallar
    kaydedilir. Kayit bicimi: [{"port": N, "kaynak": "10.0.0.0/8" | null}]."""
    ayar = ayar if ayar is not None else CP.ayar_oku(AYAR)
    acilan = []
    if ufw_aktif():
        for port in portlar:
            for kaynak in izin_kaynaklari(ayar):
                kod, cikti = calistir(["ufw", "allow"] + izin_komutu(port, kaynak)
                                      + ["comment", "carotpot"])
                if kural_eklendi_mi(kod, cikti):
                    acilan.append({"port": int(port), "kaynak": kaynak})
    json_yaz(ACILAN, acilan)
    return acilan


def portlari_kapat():
    """Yalnizca CarotPot'un kendi ekledigi (ACILAN'a yazilmis) kurallari siler."""
    kalan = []
    for kayit in json_oku(ACILAN, []):
        if isinstance(kayit, int):                  # eski bicim: kaynaksiz kural
            kayit = {"port": kayit, "kaynak": None}
        if not isinstance(kayit, dict):
            continue
        port, kaynak = kayit.get("port"), kayit.get("kaynak")
        if not isinstance(port, int) or isinstance(port, bool) or not 1024 <= port <= 65535:
            continue
        if kaynak is not None and kaynak not in izin_kaynaklari({}):
            continue
        kod, _ = calistir(["ufw", "delete", "allow"] + izin_komutu(port, kaynak))
        if kod != 0:
            kalan.append({"port": port, "kaynak": kaynak})   # sonraki denemede yine silinir
    json_yaz(ACILAN, kalan)


def hizmet_acik_portlari(ayar, sure=20.0):
    """Hizmetin durum dosyasindan GERCEKTEN dinlenen tuzak portlari (port
    baska programdaysa o port yoktur). Dosya hizmet kullanicisinin dizininde:
    sembolik bag izlenmez, yalnizca ayardaki portlarla kesisim alinir.
    Zamaninda hazir olmazsa bos liste."""
    ana_pid = os.environ.get("MAINPID", "")
    bas = time.time()
    while time.time() - bas < sure:
        try:
            fd = os.open(DURUM, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
            with os.fdopen(fd, encoding="utf-8") as fh:
                durum = json.loads(fh.read(65536))
            yeni = (str(durum.get("pid")) == ana_pid if ana_pid.isdigit()
                    else durum.get("baslangic", 0) >= bas - 10)
            acik = durum.get("acik")
            if yeni and isinstance(acik, dict):
                izinli = {p for p in ayar["portlar"].values() if p}
                return sorted({p for p in acik.values()
                               if isinstance(p, int) and not isinstance(p, bool)
                               and p in izinli})
        except (OSError, ValueError, AttributeError):
            pass
        time.sleep(0.2)
    return []


# --- komutlar -------------------------------------------------------------------

def k_baslat():
    ayar = CP.ayar_oku(AYAR)
    if not os.path.exists(AYAR):
        json_yaz(AYAR, ayar)
    portlari_kapat()
    # Izinleri birimin ExecStartPost'u (izin-ac) hizmet portlari actiktan sonra
    # ekler; boylece cokup yeniden baslamada da ayni yoldan gecer.
    kod, cikti = calistir(["systemctl", "start", HIZMET])
    if kod != 0:
        portlari_kapat()
        cikis("__BASLATILAMADI__", cikti=cikti[-2000:])
    acilan = sorted({k["port"] for k in json_oku(ACILAN, []) if isinstance(k, dict)})
    cikis("__TAMAM__", ufw_izinleri=acilan)


def k_durdur():
    kod, cikti = calistir(["systemctl", "stop", HIZMET])
    portlari_kapat()          # ExecStopPost zaten sildi; kalan varsa
    if kod != 0:
        cikis("__DURDURULAMADI__", cikti=cikti[-2000:])
    cikis("__TAMAM__")


def k_izin_ac():
    """carotpot.service ExecStartPost (root): once kalmis izinler silinir,
    sonra yalnizca hizmetin dinleyebildigi portlar acilir."""
    ayar = CP.ayar_oku(AYAR)
    portlari_kapat()
    acilan = portlari_ac(hizmet_acik_portlari(ayar), ayar)
    if acilan and not os.path.exists(ENGELLILER):
        # Acilistaki temizlik birimi (carotpot-engel-temizle) bu dosya varsa
        # calisir; makine tuzak acikken kapanirsa izinler orada silinir.
        json_yaz(ENGELLILER, [])
    cikis("__TAMAM__", ufw_izinleri=sorted({k["port"] for k in acilan}))


def k_izin_kapat():
    portlari_kapat()
    cikis("__TAMAM__")


def k_izin_temizle():
    """Acilista: hizmet calismiyorsa (cokme, elektrik kesintisi) kalmis
    izinleri siler. Yalnizca hizmet kesin olarak durmussa: "activating"
    durumunda ExecStartPost izinleri ekliyor olabilir."""
    kod, cikti = calistir(["systemctl", "show", "-p", "ActiveState", "--value", HIZMET])
    if kod == 0 and cikti.strip() in ("inactive", "failed"):
        portlari_kapat()
    cikis("__TAMAM__")


def k_ayar():
    try:
        veri = json.loads(sys.stdin.read(65536))
        ayar = CP.ayar_dogrula(veri)
    except ValueError as hata:
        cikis("__AYAR_HATASI__", ayrinti=str(hata))
    json_yaz(AYAR, ayar)
    kod, _ = calistir(["systemctl", "is-active", "--quiet", HIZMET])
    if kod == 0:
        # ExecStopPost eski izinleri siler, ExecStartPost yeni ayarin
        # kapsamiyla (yerel ag / internet) yalnizca acilan portlara ekler
        calistir(["systemctl", "restart", HIZMET])
    cikis("__TAMAM__")


SURE_SINIRI = 7 * 24 * 60     # dakika: en fazla bir hafta


def sure_coz(ham):
    if ham is None:
        return None
    if not ham.isdigit() or not 1 <= int(ham) <= SURE_SINIRI:
        cikis("__GECERSIZ_SURE__")
    return int(ham)


def zamanlayici_kur(saniye):
    """Suresi dolunca sure-denetle'yi calistiracak gecici systemd
    zamanlayicisi. Yeniden baslatmada kaybolur; o durumda acilistaki
    carotpot-engel-temizle birimi temizler."""
    calistir(["systemd-run", "--quiet", "--collect",
              f"--unit=carotpot-sure-{int(time.time())}-{os.getpid()}",
              f"--on-active={int(saniye) + 5}s", "--timer-property=AccuracySec=15s",
              "/usr/bin/python3", "-I", KENDISI, "sure-denetle"])


def k_engelle(ham, sure_ham=None):
    dakika = sure_coz(sure_ham)
    ip = engel_adresi_dogrula(ham)
    if not ufw_aktif():
        cikis("__UFW_KAPALI__")
    kod, cikti = calistir(["ufw", "prepend", "deny", "from", ip, "to", "any",
                           "comment", "carotpot-engel"])
    if kod != 0:
        kod, cikti = calistir(["ufw", "deny", "from", ip, "to", "any",
                               "comment", "carotpot-engel"])
    if kod != 0:
        cikis("__UFW_HATASI__", cikti=cikti[-1000:])
    simdi = int(time.time())
    kayit = {"ip": ip, "tarih": simdi}
    if dakika:
        kayit["bitis"] = simdi + dakika * 60
    liste = [e for e in json_oku(ENGELLILER, []) if e.get("ip") != ip]
    liste.append(kayit)
    json_yaz(ENGELLILER, liste)
    if dakika:
        zamanlayici_kur(dakika * 60)
    cikis("__TAMAM__", ip=ip, bitis=kayit.get("bitis"))


def k_kaldir(ham):
    adr = CP.adres_coz(ham)
    if adr is None:
        cikis("__GECERSIZ_IP__")
    ip = str(adr)
    calistir(["ufw", "delete", "deny", "from", ip, "to", "any"])
    json_yaz(ENGELLILER, [e for e in json_oku(ENGELLILER, []) if e.get("ip") != ip])
    cikis("__TAMAM__", ip=ip)


def k_sure_denetle():
    simdi = time.time()
    liste = json_oku(ENGELLILER, [])
    kalan, kaldirilan = [], []
    for e in liste:
        if not isinstance(e, dict):
            continue
        bitis = e.get("bitis")
        adr = CP.adres_coz(e.get("ip", ""))
        if isinstance(bitis, (int, float)) and bitis <= simdi and adr is not None:
            calistir(["ufw", "delete", "deny", "from", str(adr), "to", "any"])
            kaldirilan.append(str(adr))
        else:
            kalan.append(e)
    if kaldirilan:
        json_yaz(ENGELLILER, kalan)
    cikis("__TAMAM__", kaldirilan=kaldirilan)


def k_parolalar(ham):
    adr = CP.adres_coz(ham)
    if adr is None:
        cikis("__GECERSIZ_IP__")
    yol = os.path.join(CP.VERI_DIZINI, "olaylar.db")
    try:
        db = sqlite3.connect(f"file:{yol}?mode=ro", uri=True)
        satirlar = db.execute(
            "SELECT hizmet, kullanici, parola, COUNT(*) FROM olaylar WHERE kaynak=? AND "
            "parola IS NOT NULL AND parola != '' GROUP BY hizmet, kullanici, parola "
            "ORDER BY 4 DESC LIMIT 50", (str(adr),)).fetchall()
        db.close()
    except sqlite3.Error:
        satirlar = []
    cikis("__TAMAM__", parolalar=[{"hizmet": h, "kullanici": k or "", "parola": p, "sayi": n}
                                  for h, k, p, n in satirlar])


def jail_metni(acik, korunan):
    return (
        "# CarotOS CarotPot: otomatik engelleme (Carotpot uygulamasi yonetir).\n"
        "# Kapali gelir (karar D8). Kendi adresleri ve ag gecitleri ignoreip'tedir.\n"
        "[carotos-carotpot]\n"
        f"enabled = {'true' if acik else 'false'}\n"
        "filter = carotos-carotpot\n"
        "logpath = /var/log/carotpot/olaylar.log\n"
        "backend = auto\n"
        "maxretry = 3\n"
        "findtime = 10m\n"
        "bantime = 1h\n"
        "banaction = ufw\n"
        f"ignoreip = {' '.join(sorted(korunan))}\n")


def k_otomatik(durum):
    if durum not in ("ac", "kapat"):
        cikis("__GECERSIZ_KOMUT__")
    acik = durum == "ac"
    if acik and not ufw_aktif():
        cikis("__UFW_KAPALI__")
    korunan = korunan_adresler() | {"127.0.0.0/8"}
    with open(JAIL + ".yeni", "w", encoding="utf-8") as fh:
        fh.write(jail_metni(acik, korunan))
    os.chmod(JAIL + ".yeni", 0o644)
    os.replace(JAIL + ".yeni", JAIL)
    if acik:
        calistir(["systemctl", "enable", "--now", "fail2ban.service"])
    kod, cikti = calistir(["fail2ban-client", "reload"])
    if acik and kod != 0:
        cikis("__FAIL2BAN_HATASI__", cikti=cikti[-1000:])
    cikis("__TAMAM__", otomatik=acik)


def main(argv):
    if os.geteuid() != 0:
        cikis("__YETKI_YOK__")
    if not argv:
        cikis("__GECERSIZ_KOMUT__")
    komut, arg = argv[0], (argv[1] if len(argv) > 1 else None)
    if komut == "baslat":
        k_baslat()
    elif komut == "durdur":
        k_durdur()
    elif komut == "izin-ac":
        k_izin_ac()
    elif komut == "izin-kapat":
        k_izin_kapat()
    elif komut == "izin-temizle":
        k_izin_temizle()
    elif komut == "ayar":
        k_ayar()
    elif komut == "engelle" and arg:
        k_engelle(arg, argv[2] if len(argv) > 2 else None)
    elif komut == "sure-denetle":
        k_sure_denetle()
    elif komut == "parolalar" and arg:
        k_parolalar(arg)
    elif komut == "kaldir" and arg:
        k_kaldir(arg)
    elif komut == "otomatik" and arg:
        k_otomatik(arg)
    cikis("__GECERSIZ_KOMUT__")


if __name__ == "__main__":
    main(sys.argv[1:])
