#!/usr/bin/python3 -I
# -*- coding: utf-8 -*-
"""CarotOS: bir sistem dilini kullanima hazirlar (root olarak, pkexec ile cagrilir).

Kullanim:  carotos-dil-hazirla <dil-kodu>      (tr en de ru es pt ja zh fr ar hi)

Yaptiklari:
  1. /etc/locale.gen'de dilin locale'ini etkinlestirir ve `locale-gen` calistirir
  2. eksik dil paketlerini (yazi tipi, Firefox/LibreOffice dili, yazim sozlugu) apt ile kurar
Yapmadiklari: /etc/default/locale'e (sistem geneli varsayilan dil) DOKUNMAZ; makinedeki
diger kullanicilari etkilemez. Oturum dilini kullanici kendi hesabinda Karsilama ayarlar.

Guvenlik: tek arguman, sabit tablodan (ortak/sistem_dili.py) dogrulanir; kabuk kullanilmaz;
yazilan satirlar ve kurulan paketler yalnizca tablodan gelir. Tablo modulu root'a ait degilse
ya da grup/herkes tarafindan yazilabiliyorsa betik hicbir sey yapmadan cikar.
"""
import os
import subprocess
import sys

MODUL_DIZINI = "/opt/carotos/ortak"
LOCALE_GEN = "/etc/locale.gen"
ORTAM = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C", "DEBIAN_FRONTEND": "noninteractive"}


def bildir(metin):
    # Okuyucu (Karsilama penceresi) gittiyse yazim hatasi islemi yarida birakmasin
    try:
        print("[carotos-dil] " + metin, flush=True)
    except (BrokenPipeError, OSError):
        try:
            sys.stdout = open(os.devnull, "w")
        except OSError:
            pass


# Guven denetimi: modul dosyasi ve kok dizine kadar butun ust dizinler bu
# kullaniciya (root) ait olmali ve grup/herkes tarafindan yazilamamali.
# Testler GUVENILIR_UID ve ZINCIR_KOKU'nu degistirir.
GUVENILIR_UID = 0
ZINCIR_KOKU = "/"


def _guvensiz(neden, yol):
    bildir("guvensiz modul (" + neden + "; root'a ait olmali, baskalarinca yazilamamali): " + yol)
    sys.exit(3)


def _guvenli_mi(st):
    return st.st_uid == GUVENILIR_UID and not (st.st_mode & 0o022)


def modulu_yukle():
    """sistem_dili.py'yi denetlenmis dosya tanitecisinden kaynak olarak yukler.

    `import` kullanilmaz: import, __pycache__ altindaki bayt kodunu kaynaktan
    once calistirabilir ve denetlenen dosya ile calisan kod ayni olmayabilir.
    Burada dosya O_NOFOLLOW ile acilir, fstat ile denetlenir ve ayni
    tanitecten okunan metin compile()+exec() ile yeni bir modul nesnesine
    yuklenir. Ust dizin zinciri de denetlenir (dizini yazabilen dosyayi
    degistirebilir)."""
    import stat as _stat
    import types
    dizin = os.path.realpath(MODUL_DIZINI)
    kok = os.path.realpath(ZINCIR_KOKU)
    d = dizin
    while True:
        try:
            st = os.stat(d)
        except OSError:
            _guvensiz("dizin okunamadi", d)
        if not _stat.S_ISDIR(st.st_mode) or not _guvenli_mi(st):
            _guvensiz("guvensiz dizin", d)
        if d == kok:
            break
        ust = os.path.dirname(d)
        if ust == d:                    # kok dizine ulasildi ama ZINCIR_KOKU yolda degil
            _guvensiz("dizin zinciri beklenen kokte bitmiyor", dizin)
        d = ust
    yol = os.path.join(dizin, "sistem_dili.py")
    try:
        fd = os.open(yol, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0))
    except OSError:
        _guvensiz("dosya acilamadi ya da sembolik bag", yol)
    try:
        st = os.fstat(fd)
        if not _stat.S_ISREG(st.st_mode) or not _guvenli_mi(st):
            _guvensiz("guvensiz dosya", yol)
        with os.fdopen(fd, "rb") as f:
            fd = -1
            kaynak = f.read()
    finally:
        if fd >= 0:
            os.close(fd)
    modul = types.ModuleType("sistem_dili")
    modul.__file__ = yol
    exec(compile(kaynak, yol, "exec"), modul.__dict__)
    return modul


def calistir(komut):
    # restore_signals=False: Python SIGPIPE'i yok sayar; apt/dpkg bunu miras alir ve
    # okuyucu gidince olmek yerine yazim hatasi (EPIPE) alip isini bitirir.
    return subprocess.run(komut, env=ORTAM, restore_signals=False).returncode


def locale_etkinlestir(SD, kod):
    satir = SD.locale_gen_satiri(kod)
    try:
        with open(LOCALE_GEN, "r", encoding="utf-8") as f:
            satirlar = f.read().splitlines()
    except FileNotFoundError:
        satirlar = []
    sonuc, bulundu = [], False
    for s in satirlar:
        if s.strip() == satir:
            bulundu = True                         # zaten etkin
        elif s.strip().lstrip("#").strip() == satir:
            s, bulundu = satir, True               # yorumdan cikar
        sonuc.append(s)
    if not bulundu:
        sonuc.append(satir)
    gecici = LOCALE_GEN + ".carotos-yeni"
    with open(gecici, "w", encoding="utf-8") as f:
        f.write("\n".join(sonuc) + "\n")
    os.chmod(gecici, 0o644)
    os.replace(gecici, LOCALE_GEN)


def main(argv):
    if os.geteuid() != 0:
        bildir("root olarak calistirilmali (pkexec)")
        return 2
    if len(argv) != 2:
        bildir("kullanim: carotos-dil-hazirla <dil-kodu>")
        return 2
    SD = modulu_yukle()
    kod = argv[1]
    if kod not in SD.HAZIRLIK:
        bildir("bilinmeyen dil kodu")
        return 2
    if kod in ("tr", "en"):
        bildir("bu dil icin hazirlik gerekmiyor")
        return 0

    bildir("1/3 locale: " + SD.locale_adi(kod))
    if not SD.locale_var_mi(kod, SD.locale_a()):
        locale_etkinlestir(SD, kod)
        if calistir(["locale-gen"]) != 0:
            bildir("locale-gen basarisiz")
            return 1

    kurulu = SD.kurulu_paketler()
    eksik = SD.eksik_paketler(kod, kurulu)
    if not eksik:
        bildir("2/3 paketler: hepsi kurulu")
        bildir("3/3 tamam")
        return 0
    bildir("2/3 paketler: " + " ".join(eksik))
    if calistir(["apt-get", "update"]) != 0:
        bildir("uyari: depo listesi guncellenemedi (cevrimdisi olabilir), kurulum deneniyor")
    if calistir(["apt-get", "install", "-y", "--no-install-recommends"] + eksik) != 0:
        bildir("paket kurulumu basarisiz (internet baglantisini ve baska bir paket yoneticisinin calismadigini kontrol edin)")
        return 4                        # locale hazir; yalniz ek paketler eksik
    bildir("3/3 tamam")
    return 0


if __name__ == "__main__":
    # Modulun kendi alt surecleri (dpkg-query, locale) de sabit PATH ve LC_ALL=C ile calissin
    os.environ.update(ORTAM)
    sys.dont_write_bytecode = True
    sys.exit(main(sys.argv))
