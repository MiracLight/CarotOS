#!/usr/bin/python3 -I
# -*- coding: utf-8 -*-
"""Oturum acilisinda bir kez calisir ve cikar (kullanici yetkisiyle, yalniz kendi ayarlari).

1. Panel baslaticilarinin ad/aciklama satirlarini sistemdeki asil .desktop dosyasindan yeniler: panel kopyalari
   yalniz tr/en tasiyordu, secilen dilde Ingilizce gorunuyordu. Kullanicinin degistirdigi baslaticiya (Exec farkli)
   dokunulmaz.
2. Eski gtk.css blogunu onarir: panel zemini CSS'ten kalkar (Xfce panel ayarlari calissin), panel menuleri okunur olur,
   yazi rengi temadan gelir.
3. Paneller, panel menuleri ve pencere cercevesi masaustu temasiyla (acik/koyu) ayni kipe getirilir.
4. Pil simgesi yalniz pilli bilgisayarda gosterilir.

  carotos-panel-eslestir            oturum
  carotos-panel-eslestir --skel D   derlemede /etc/skel gibi bir ev dizini icin yalniz 1. adim
  carotos-panel-eslestir --tema dark|light   Karsilama'da tema secilince (3)
  carotos-panel-eslestir --esle              Sleek kapaninca (3)
"""
import glob
import os
import re
import subprocess
import sys
import tempfile

ADLAR = re.compile(r"(Name|GenericName|Comment|Keywords)(\[[^\]]+\])?=")
KAYNAK = re.compile(r"^X-XFCE-Source=file://(/usr/share/applications/[A-Za-z0-9._-]+\.desktop)$", re.M)
KOYU, ACIK = (0.118, 0.129, 0.161, 0.90), (0.961, 0.965, 0.969, 0.95)      # ust panelin varsayilan zeminleri
# Eski gtk.css panel yazisini hep acik renk yapiyordu: renk temadan gelsin (Sleek blogu bu bicimde yazmaz)
ESKI_RENK = (("\n.xfce4-panel button,\n.xfce4-panel label,\n.xfce4-panel image {\n  color: #e6e9ef;",
              "\n.xfce4-panel.panel widget,\n.xfce4-panel button,\n.xfce4-panel label,\n.xfce4-panel image {"
              "\n  color: @theme_fg_color;"),
             ("\n  color: #e6e9ef;", "\n  color: @theme_fg_color;"),
             ("\n  background-color: rgba(255, 255, 255, 0.10);", "\n  background-color: alpha(currentColor, 0.10);"),
             ("\n  background-color: rgba(255, 255, 255, 0.18);", "\n  background-color: alpha(currentColor, 0.18);"))
ESKI_ZEMIN = re.compile(
    r"/\* Paneller: yari saydam[^\n]*\n\.xfce4-panel\.panel,\n#XfcePanelWindow \{\n"
    r"  background-color: rgba\(30, 33, 41, 0\.90\);\n  border: none;\n\}\n\n?")
MENU = """
/* Panele bagli menuler: renkleri temaya dondur */
.xfce4-panel menu, .xfce4-panel menu menuitem, .xfce4-panel menu label, .xfce4-panel menu image {
  color: @theme_text_color;
}
.xfce4-panel menu { background-color: @theme_base_color; }
.xfce4-panel menu menuitem:hover, .xfce4-panel menu menuitem:hover > * {
  color: @theme_selected_fg_color;
  background-color: @theme_selected_bg_color;
}
"""


def oku(yol):
    try:
        with open(yol, encoding="utf-8") as f:
            return f.read(1 << 18)
    except (OSError, ValueError):
        return None


def yaz(yol, metin):
    izin = os.stat(yol).st_mode & 0o777
    fd, gecici = tempfile.mkstemp(prefix=".carotos-", dir=os.path.dirname(yol))
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(metin)
    os.chmod(gecici, izin)
    os.replace(gecici, yol)


def ana_grup(metin):
    """[Desktop Entry] grubunun satirlari (eylem gruplari haric)."""
    return re.split(r"^\[(?!Desktop Entry\])", metin, maxsplit=1, flags=re.M)[0].splitlines()


def yeni_metin(kopya, asil):
    """Kopyanin ad satirlari asilinkilerle degisir; degisiklik gerekmiyorsa None."""
    def deger(satirlar, anahtar):
        s = next((s for s in satirlar if s.startswith(anahtar + "=")), None)
        return s and re.sub(r" *%[a-zA-Z]", "", s)
    ks, as_ = ana_grup(kopya), ana_grup(asil)
    if deger(ks, "Exec") != deger(as_, "Exec"):
        return None
    ad = [s for s in as_ if ADLAR.match(s)]
    if not deger(ad, "Name") or sorted(s for s in ks if ADLAR.match(s)) == sorted(ad):
        return None
    return "\n".join([ks[0]] + ad + [s for s in ks[1:] if not ADLAR.match(s)]).rstrip("\n") + "\n"


def baslaticilar(config):
    for yol in glob.glob(os.path.join(glob.escape(config), "xfce4", "panel", "launcher-*", "*.desktop")):
        kopya = None if os.path.islink(yol) else oku(yol)
        m = KAYNAK.search(kopya) if kopya else None
        asil = oku(m.group(1)) if m else None
        yeni = yeni_metin(kopya, asil) if asil else None
        if yeni:
            yaz(yol, yeni)


def css_onar(metin):
    """Eski panel zemini kurali varsa kaldirilmis, menu kurallari eklenmis, yazi rengi temaya donmus metin; gerekmiyorsa None."""
    yeni, n = ESKI_ZEMIN.subn("", metin)
    for eski, rengi in ESKI_RENK:
        yeni = yeni.replace(eski, rengi)
    if yeni == metin:
        return None
    if not n:
        return yeni
    return yeni if ".xfce4-panel menu" in yeni else yeni.rstrip("\n") + "\n" + MENU


def xq(kanal, ozellik, *yazilan):
    """xfconf oku (yoksa "") ya da yaz."""
    return subprocess.run(["/usr/bin/xfconf-query", "-c", kanal, "-p", ozellik, *yazilan], text=True, timeout=10,
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.strip()


def sleek_acik():
    return os.path.isfile(os.path.expanduser("~/.local/state/carotos/sleek-yedek.json"))


def rgba_coz(metin):
    """xfconf-query dizi ciktisi -> [r, g, b, a]; dizi degilse None."""
    try:
        d = [float(s.replace(",", ".")) for s in metin.splitlines() if re.fullmatch(r"[0-9.,eE+-]+", s.strip())]
    except ValueError:
        return None
    return d if len(d) == 4 else None


def ayni(a, b):
    return all(abs(x - y) < 0.006 for x, y in zip(a, b))


def panel_karari(stil, rgba, koyu, acikca):
    """(yazilacak zemin ya da None, panel koyu kipte mi ya da None).

    Zemin yalniz bizim varsayilanlarimizdan biriyse tema ile degisir; kullanicinin rengi korunur ve yazilar o rengin
    ustunde okunacak kipe alinir. acikca=False (oturum acilisi): bos zemine dokunulmaz."""
    if stil == "1" and rgba and not (ayni(rgba, KOYU) or ayni(rgba, ACIK)):
        return None, 0.299 * rgba[0] + 0.587 * rgba[1] + 0.114 * rgba[2] < 0.5
    if stil == "2" or (stil != "1" and not acikca):
        return None, None
    hedef = KOYU if koyu else ACIK
    return (None if stil == "1" and rgba and ayni(rgba, hedef) else hedef), koyu


def panel_temasi(koyu, acikca):
    """Panelleri, panel menulerini ve GTK4 uygulamalarini masaustu temasiyla ayni kipe getirir."""
    if sleek_acik():                                  # Sleek kendi koyu panelini yonetir; kapaninca --esle cagirir
        return
    for no in "12":
        if not xq("xfce4-panel", "/panels/panel-%s/plugin-ids" % no):
            continue                                  # kullanici paneli kaldirmis
        kok = "/panels/panel-%s/background-" % no
        stil = xq("xfce4-panel", kok + "style")
        # Alt panelin zemini eskiden hic yazilmiyordu; Arc'in acik temasi da paneli koyu boyar
        zemin, kip = panel_karari(stil or "0", rgba_coz(xq("xfce4-panel", kok + "rgba")), koyu,
                                  acikca or (no == "2" and not stil))
        if no == "1" and kip is not None and xq("xfce4-panel", "/panels/dark-mode") != str(kip).lower():
            xq("xfce4-panel", "/panels/dark-mode", "-n", "-t", "bool", "-s", str(kip).lower())
        if zemin:
            xq("xfce4-panel", kok + "rgba", "-n", "-a", *[x for v in zemin for x in ("-t", "double", "-s", str(v))])
            xq("xfce4-panel", kok + "style", "-n", "-t", "uint", "-s", "1")
    if acikca:
        try:                                          # GTK4/libadwaita uygulamalari ve tarayicilar
            subprocess.run(["/usr/bin/gsettings", "set", "org.gnome.desktop.interface", "color-scheme",
                            "prefer-dark" if koyu else "default"], timeout=10,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError):
            pass


def tema_esle():
    """Oturum acilisi: tema baska yoldan (Xfce Gorunum, guncelleme) degistiyse cerceve ve panel de uyar."""
    tema = xq("xsettings", "/Net/ThemeName")
    if not tema:
        return
    if {tema, xq("xfwm4", "/general/theme")} == {"Arc", "Arc-Dark"} and not sleek_acik():
        xq("xfwm4", "/general/theme", "-s", tema)
    panel_temasi("dark" in tema.lower(), False)


def pil_var(kok="/sys/class/power_supply"):
    """Bilgisayarin kendi pili (fare/klavye pilleri scope=Device sayilmaz)."""
    for d in glob.glob(os.path.join(kok, "*")):
        def deger(ad, d=d):
            return (oku(os.path.join(d, ad)) or "").strip()
        if deger("type") == "Battery" and deger("scope") != "Device" and deger("present") != "0":
            return True
    return False


def pil_simgesi():
    """Tepsi simgesi yalniz pilli bilgisayarda. Pilli bilgisayarda bir kez acilir; kullanici kapatirsa kapali kalir."""
    kanal, kok = "xfce4-power-manager", "/xfce4-power-manager/"
    if not pil_var():
        xq(kanal, kok + "show-tray-icon", "-n", "-t", "bool", "-s", "false")
        if xq(kanal, kok + "carotos-pil-acildi"):      # disk pilli bir bilgisayara takilirsa yeniden acilsin
            xq(kanal, kok + "carotos-pil-acildi", "-r")
    elif xq(kanal, kok + "carotos-pil-acildi") != "true":
        for ad in ("show-tray-icon", "carotos-pil-acildi"):
            xq(kanal, kok + ad, "-n", "-t", "bool", "-s", "true")


def main(argv):
    if argv[1:2] == ["--skel"]:
        baslaticilar(os.path.join(argv[2], ".config"))
        return 0
    if argv[1:2] == ["--tema"]:
        panel_temasi(argv[2:3] == ["dark"], True)
        return 0
    if argv[1:2] == ["--esle"]:
        tema_esle()
        return 0
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    baslaticilar(config)
    css = os.path.join(config, "gtk-3.0", "gtk.css")
    eski = None if os.path.islink(css) else oku(css)
    yeni = css_onar(eski) if eski else None
    if yeni is not None:
        yaz(css, yeni)
        if ESKI_ZEMIN.search(eski) and xq("xfce4-panel", "/panels/panel-1/background-style") in ("", "0"):
            panel_temasi("dark" in xq("xsettings", "/Net/ThemeName").lower(), True)
    tema_esle()
    pil_simgesi()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except (OSError, ValueError, subprocess.SubprocessError) as hata:
        print("carotos-panel-eslestir:", hata, file=sys.stderr)
        sys.exit(1)
