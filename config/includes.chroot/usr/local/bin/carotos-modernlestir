def sanal_makine_mi(o):
    kod, _ = o.calistir([o.prog("systemd-detect-virt"), "--vm", "--quiet"])
    return kod == 0


def yazi_tipi_var(o, aile):
    kod, cikti = o.calistir([o.prog("fc-list"), ":family=" + aile, "family"])
    return kod == 0 and bool(cikti.strip())


def _ilk_var(adaylar, kok, alt):
    for a in adaylar:
        if os.path.exists(os.path.join(kok, a, alt)):
            return a
    return None


def _uygulama_yolu(o, ad):
    yol = os.path.join(o.uygulamalar, ad)
    return yol if os.path.isfile(yol) else None


def _baslatici_kaynagi(o, dosya):
    """Panel baslaticisinin sistemdeki asil .desktop dosyasi (X-XFCE-Source), yoksa dosyanin kendisi."""
    try:
        metin = oku(dosya, 65536) or ""
    except UygulamaHatasi:
        return None
    m = re.search(r"^X-XFCE-Source=file://(\S+)$", metin, re.M)
    if m:
        kaynak = urllib.parse.unquote(m.group(1))
        if (os.path.dirname(kaynak) == o.uygulamalar.rstrip("/") and kaynak.endswith(".desktop")
                and os.path.isfile(kaynak)):
            return kaynak
    return dosya


def _int_listesi(deger):
    if not isinstance(deger, list):
        return []
    return [d.strip() for d in deger if d.strip().isdigit()]


def panel_plani(o, plan):
    var, paneller = xq_oku(o, "xfce4-panel", "/panels")
    paneller = _int_listesi(paneller) if var else []
    if not paneller:
        plan["uyarilar"].append("panel listesi okunamadi; panel ayarlari atlandi")
        return []
    ana = paneller[0]
    plan["xfconf"] += [
        ("xfce4-panel", "/panels/panel-%s/size" % ana, "uint", PANEL_BOYU),
        ("xfce4-panel", "/panels/panel-%s/background-style" % ana, "uint", 0),
    ]
    _, ana_eklentiler = xq_oku(o, "xfce4-panel", "/panels/panel-%s/plugin-ids" % ana)
    for eid in _int_listesi(ana_eklentiler):
        _, tur = xq_oku(o, "xfce4-panel", "/plugins/plugin-%s" % eid)
        if tur == "clock":
            plan["xfconf"].append(("xfce4-panel", "/plugins/plugin-%s/digital-time-format" % eid,
                                   "string", SAAT_BICIMI))
    baslaticilar, gizlenen = [], []
    for pid in paneller[1:]:
        _, eklentiler = xq_oku(o, "xfce4-panel", "/panels/panel-%s/plugin-ids" % pid)
        eklentiler = _int_listesi(eklentiler)
        turler = {}
        for eid in eklentiler:
            _, tur = xq_oku(o, "xfce4-panel", "/plugins/plugin-%s" % eid)
            turler[eid] = tur
        if not eklentiler or not set(turler.values()) <= DOCK_PANEL_TURLERI \
                or "launcher" not in turler.values():
            continue
        gizlenen.append(pid)
        for eid in eklentiler:
            if turler[eid] != "launcher":
                continue
            _, ogeler = xq_oku(o, "xfce4-panel", "/plugins/plugin-%s/items" % eid)
            for oge in ogeler if isinstance(ogeler, list) else []:
                oge = oge.strip()
                if "/" in oge or not oge.endswith(".desktop"):
                    continue
                dosya = o.yol("xfce4", "panel", "launcher-%s" % eid, oge)
                if os.path.isfile(dosya):
                    kaynak = _baslatici_kaynagi(o, dosya)
                    if kaynak:
                        baslaticilar.append(kaynak)
    if gizlenen:
        plan["paneller"] = [p for p in paneller if p not in gizlenen]
        plan["uyarilar"].append("alt dock paneli (panel-%s) plank ile cakismasin diye gizlendi; "
                                "geri al ile doner" % ", panel-".join(gizlenen))
    return baslaticilar


def _dockitem_adi(desktop_yolu):
    taban = os.path.basename(desktop_yolu)[:-len(".desktop")]
    return "carotos-" + re.sub(r"[^A-Za-z0-9._-]", "_", taban) + ".dockitem"


def _gvariant_dizi(metin):
    return re.findall(r"'((?:[^'\\]|\\.)*)'", metin or "")


def plan_olustur(o):
    plan = {"xfconf": [], "dosyalar": {}, "terminalrc": list(TERMINALRC_ANAHTARLARI),
            "terminal_xfconf": False, "gsettings": [], "paneller": None, "uyarilar": []}
    sanal = sanal_makine_mi(o)
    plan["sanal"] = sanal

    # 1) GTK / xfwm4
    tema = _ilk_var(TEMA_ADAYLARI, o.temalar, "gtk-3.0")
    if tema:
        plan["xfconf"].append(("xsettings", "/Net/ThemeName", "string", tema))
        xfwm = _ilk_var((tema,) + TEMA_ADAYLARI, o.temalar, os.path.join("xfwm4", "themerc"))
        if xfwm:
            plan["xfconf"].append(("xfwm4", "/general/theme", "string", xfwm))
        else:
            plan["uyarilar"].append("Orchis'in xfwm4 temasi bulunamadi; pencere kenarligi temasi degismedi")
    else:
        plan["uyarilar"].append("Orchis temasi bulunamadi; GTK temasi degismedi")
    plan["tema"] = tema
    simge = _ilk_var(SIMGE_ADAYLARI, o.simgeler, "index.theme")
    if simge:
        plan["xfconf"].append(("xsettings", "/Net/IconThemeName", "string", simge))
    imlec = _ilk_var(IMLEC_ADAYLARI, o.simgeler, "cursors")
    if imlec:
        plan["xfconf"] += [("xsettings", "/Gtk/CursorThemeName", "string", imlec),
                           ("xsettings", "/Gtk/CursorThemeSize", "int", IMLEC_BOYU)]
    else:
        plan["uyarilar"].append("Bibata imleci bulunamadi; imlec degismedi")
    inter = yazi_tipi_var(o, UI_YAZI)
    mono = yazi_tipi_var(o, MONO_YAZI)
    if inter:
        plan["xfconf"] += [("xsettings", "/Gtk/FontName", "string", UI_YAZI + " 10"),
                           ("xfwm4", "/general/title_font", "string", UI_YAZI + " Bold 10")]
    else:
        plan["uyarilar"].append("Inter yazi tipi bulunamadi; arayuz yazi tipi degismedi")
    if mono:
        plan["xfconf"].append(("xsettings", "/Gtk/MonospaceFontName", "string", MONO_YAZI + " 10"))
    plan["xfconf"].append(("xfwm4", "/general/title_alignment", "string", "center"))

    # 3) Panel (konum/boyut/saydamlik; eklenti yerlesimine dokunulmaz)
    panel_baslaticilari = panel_plani(o, plan)

    # 5) Rofi kisayolu: Super+Space baska ise atanmissa eklenmez
    rasi = o.yol("rofi", "carotos.rasi")
    plan["dosyalar"][rasi] = rofi_temasi(o.dil)
    rofi_komutu = "%s -show drun -theme %s" % (o.prog("rofi"), desktop_exec_alintila(rasi))
    dolu = False
    for yol in ("/commands/custom/" + KISAYOL, "/xfwm4/custom/" + KISAYOL):
        var, deger = xq_oku(o, "xfce4-keyboard-shortcuts", yol)
        if var and not (isinstance(deger, str) and "carotos.rasi" in deger):
            dolu = True
    if dolu:
        plan["uyarilar"].append("Super+Space baska bir ise atanmis; rofi kisayolu EKLENMEDI")
    else:
        plan["xfconf"].append(("xfce4-keyboard-shortcuts", "/commands/custom/" + KISAYOL, "string",
                               rofi_komutu))

    # 6) Terminal
    if not mono:
        plan["terminalrc"] = [(k, v) for k, v in plan["terminalrc"] if k not in ("FontName", "FontUseSystem")]
    if xq_kanal_dolu(o, "xfce4-terminal"):
        plan["terminal_xfconf"] = True
        for ozellik, tur, deger in TERMINAL_XFCONF:
            if not mono and ozellik in ("/font-name", "/font-use-system"):
                continue
            plan["xfconf"].append(("xfce4-terminal", ozellik, tur, deger))

    # 1) picom + xfwm4 birlestiricisi (EN SON: picom hemen ardindan baslar)
    picom = o.yol("picom", "picom.conf")
    plan["dosyalar"][picom] = picom_conf(sanal)
    plan["dosyalar"][o.yol("autostart", "carotos-picom.desktop")] = autostart_metni(
        "CarotOS picom", [o.prog("picom"), "--config", picom])
    plan["dosyalar"][o.yol("autostart", "carotos-plank.desktop")] = autostart_metni(
        "CarotOS plank", [o.prog("plank")])

    # 4) Dock: varsayilanlar + gizlenen paneldeki baslaticilar
    secilen = []
    for grup in DOCK_VARSAYILAN:
        for ad in grup:
            yol = _uygulama_yolu(o, ad)
            if yol:
                secilen.append(yol)
                break
    for yol in panel_baslaticilari:
        if yol not in secilen:
            secilen.append(yol)
    baslatici_dizini = o.yol("plank", "dock1", "launchers")
    adlar = []
    for yol in secilen:
        ad = _dockitem_adi(yol)
        if ad in adlar:
            continue
        adlar.append(ad)
        plan["dosyalar"][os.path.join(baslatici_dizini, ad)] = (
            "[PlankDockItemPreferences]\nLauncher=file://%s\n" % urllib.parse.quote(yol))
    _, mevcut = o.calistir([o.prog("gsettings"), "get", PLANK_SEMA, "dock-items"])
    ogeler = _gvariant_dizi(mevcut)
    ogeler += [a for a in adlar if a not in ogeler]
    plan["gsettings"] = [
        ("position", "'bottom'"), ("alignment", "'center'"), ("hide-mode", "'intelligent'"),
        ("zoom-enabled", "true"), ("zoom-percent", "150"), ("icon-size", "44"),
        ("dock-items", "[" + ", ".join("'%s'" % a for a in ogeler) + "]"),
    ]

    plan["xfconf"].append(("xfwm4", "/general/use_compositing", "bool", False))
    return plan


# ---------------------------------------------------------------------------
# Yedek
# ---------------------------------------------------------------------------

def _anahtar(kanal, ozellik):
    return kanal + "|" + ozellik


def yedek_oku(o):
    """dict, yoksa None; bozuksa kenara alinir ve UygulamaHatasi('bozuk')."""
    try:
        metin = oku(o.yedek_yolu)
    except UygulamaHatasi:
        metin = "<okunamadi>"
    if metin is None:
        return None
    try:
        veri = json.loads(metin)
        if not isinstance(veri, dict) or veri.get("surum") != YEDEK_SURUM:
            raise ValueError("surum")
        for alan, tur in (("xfconf", list), ("dosyalar", dict), ("terminalrc", dict), ("gsettings", dict)):
            if not isinstance(veri.get(alan), tur):
                raise ValueError(alan)
        return veri
    except ValueError:
        hedef = o.yedek_yolu + ".bozuk"
        try:
            os.replace(o.yedek_yolu, hedef)
        except OSError:
            pass
        raise UygulamaHatasi("bozuk")


def yedek_yaz(o, yedek):
    os.makedirs(o.durum_dizini, mode=0o700, exist_ok=True)
    atomik_yaz(o.yedek_yolu, json.dumps(yedek, ensure_ascii=False, indent=1, sort_keys=True) + "\n", 0o600)


def yedegi_genislet(o, plan, yedek):
    """Planin dokunacagi ve yedekte HENUZ olmayan her seyin simdiki halini ekler (ilk yedek ezilmez)."""
    if yedek is None:
        yedek = {"surum": YEDEK_SURUM, "olusturma": time.strftime("%Y-%m-%d %H:%M:%S"),
                 "xfconf": [], "dosyalar": {}, "terminalrc": {}, "gsettings": {}, "css": False}
    bilinen = {_anahtar(x["kanal"], x["ozellik"]) for x in yedek["xfconf"]}
    for kanal, ozellik, tur, _ in plan["xfconf"]:
        if _anahtar(kanal, ozellik) in bilinen:
            continue
        var, deger = xq_oku(o, kanal, ozellik)
        yedek["xfconf"].append({"kanal": kanal, "ozellik": ozellik, "tur": tur, "var": var, "deger": deger})
        bilinen.add(_anahtar(kanal, ozellik))
    if plan["paneller"] is not None and _anahtar("xfce4-panel", "/panels") not in bilinen:
        var, deger = xq_oku(o, "xfce4-panel", "/panels")
        yedek["xfconf"].append({"kanal": "xfce4-panel", "ozellik": "/panels", "tur": "dizi:int",
                                "var": var, "deger": deger})
    for yol in plan["dosyalar"]:
        if yol not in yedek["dosyalar"]:
            icerik = oku(yol)
            yedek["dosyalar"][yol] = {"vardi": icerik is not None, "icerik": icerik}
    trc = o.yol("xfce4", "terminal", "terminalrc")
    if "anahtarlar" not in yedek["terminalrc"]:
        yedek["terminalrc"] = {"vardi": os.path.exists(trc), "anahtarlar": {}}
    _, eski = terminalrc_ayarla(oku(trc), plan["terminalrc"])
    for k, v in eski.items():
        yedek["terminalrc"]["anahtarlar"].setdefault(k, v)
    for anahtar, _ in plan["gsettings"]:
        if anahtar not in yedek["gsettings"]:
            kod, cikti = o.calistir([o.prog("gsettings"), "get", PLANK_SEMA, anahtar])
            yedek["gsettings"][anahtar] = cikti.strip() if kod == 0 and cikti.strip() else None
    yedek["css"] = True
    return yedek


# ---------------------------------------------------------------------------
# Surecler
# ---------------------------------------------------------------------------

def surec_calisiyor(o, ad):
    kod, _ = o.calistir([o.prog("pgrep"), "-u", str(o.uid), "-x", ad])
    return kod == 0


def surec_durdur(o, ad):
    o.calistir([o.prog("pkill"), "-u", str(o.uid), "-x", ad])


def paneli_yeniden_kur(o, ayarla):
    """/panels degisikligi calisan panele ancak yeniden baslatinca yansir: kapat, ayarla, baslat."""
    calisiyor = surec_calisiyor(o, "xfce4-panel")
    if calisiyor:
        o.calistir([o.prog("xfce4-panel"), "--quit"])
        for _ in range(25):
            if not surec_calisiyor(o, "xfce4-panel"):
                break
            o.bekle(0.2)
    try:
        ayarla()
    finally:
        if calisiyor and not surec_calisiyor(o, "xfce4-panel"):
            o.baslat([o.prog("xfce4-panel")])


def _guvenli_yol(o, yol):
    if not isinstance(yol, str) or not os.path.isabs(yol):
        return False
    gercek = os.path.realpath(os.path.dirname(yol))
    for kok in {os.path.realpath(o.ev), os.path.realpath(o.config)}:
        if gercek == kok or gercek.startswith(kok + os.sep):
            return True
    return False


# ---------------------------------------------------------------------------
# Uygula / geri al
# ---------------------------------------------------------------------------

def _uygula_plan(o, plan):
    for kanal, ozellik, tur, deger in plan["xfconf"]:
        if (kanal, ozellik) == ("xfwm4", "/general/use_compositing"):
            continue
        xq_yaz(o, kanal, ozellik, tur, deger)
    for yol, metin in plan["dosyalar"].items():
        atomik_yaz(yol, metin, 0o644 if yol.endswith(".desktop") else 0o600)
    css = o.yol("gtk-3.0", "gtk.css")
    eski_css = oku(css)
    atomik_yaz(css, css_blok_ekle(eski_css, css_blogu()), 0o644)
    trc = o.yol("xfce4", "terminal", "terminalrc")
    yeni_trc, _ = terminalrc_ayarla(oku(trc), plan["terminalrc"])
    atomik_yaz(trc, yeni_trc, 0o644)
    for anahtar, deger in plan["gsettings"]:
        kod, _ = o.calistir([o.prog("gsettings"), "set", PLANK_SEMA, anahtar, deger])
        if kod != 0:
            raise UygulamaHatasi("plank ayari yazilamadi: %s" % anahtar)
    # birlestirici devri: xfwm4 kapanir, picom baslar
    surec_durdur(o, "picom")
    xq_yaz(o, "xfwm4", "/general/use_compositing", "bool", False)
    o.bekle(1.0)
    if not o.baslat([o.prog("picom"), "--config", o.yol("picom", "picom.conf")]):
        raise UygulamaHatasi("picom baslatilamadi")
    if not surec_calisiyor(o, "plank"):
        o.baslat([o.prog("plank")])
    if plan["paneller"] is not None:
        paneli_yeniden_kur(o, lambda: xq_yaz(o, "xfce4-panel", "/panels", "dizi:int", plan["paneller"]))


def geri_yukle(o, yedek):
    """En iyi caba: her adimi dener, hatalari listeler."""
    hatalar = []
    surec_durdur(o, "plank")
    surec_durdur(o, "picom")
    panel_kaydi = None
    for x in reversed(yedek.get("xfconf", [])):
        try:
            if x["ozellik"] == "/panels":
                panel_kaydi = x
                continue
            if x["var"]:
                xq_yaz(o, x["kanal"], x["ozellik"], x["tur"], x["deger"])
            else:
                xq_sil(o, x["kanal"], x["ozellik"])
        except (UygulamaHatasi, KeyError, TypeError) as exc:
            hatalar.append(str(exc))
    for yol, kayit in yedek.get("dosyalar", {}).items():
        try:
            if not _guvenli_yol(o, yol):
                hatalar.append("ev dizini disinda yol atlandi: %s" % yol)
                continue
            if kayit.get("vardi"):
                atomik_yaz(yol, kayit.get("icerik") or "", 0o644 if yol.endswith(".desktop") else 0o600)
            elif os.path.lexists(yol):
                os.unlink(yol)
        except (OSError, UygulamaHatasi, AttributeError) as exc:
            hatalar.append(str(exc))
    try:
        css = o.yol("gtk-3.0", "gtk.css")
        metin = oku(css)
        if metin is not None and CSS_BAS in metin:
            atomik_yaz(css, css_blok_kaldir(metin), 0o644)
    except (OSError, UygulamaHatasi) as exc:
        hatalar.append(str(exc))
    try:
        trc_kayit = yedek.get("terminalrc", {})
        trc = o.yol("xfce4", "terminal", "terminalrc")
        metin = oku(trc)
        if metin is not None and trc_kayit.get("anahtarlar") is not None:
            yeni = terminalrc_geri(metin, trc_kayit["anahtarlar"])
            if not trc_kayit.get("vardi") and yeni.strip() in ("", "[Configuration]"):
                os.unlink(trc)
            else:
                atomik_yaz(trc, yeni, 0o644)
    except (OSError, UygulamaHatasi) as exc:
        hatalar.append(str(exc))
    for anahtar, eski in yedek.get("gsettings", {}).items():
        argv = ([o.prog("gsettings"), "set", PLANK_SEMA, anahtar, eski] if eski is not None
                else [o.prog("gsettings"), "reset", PLANK_SEMA, anahtar])
        if o.calistir(argv)[0] != 0:
            hatalar.append("plank ayari geri yuklenemedi: %s" % anahtar)
    if panel_kaydi is not None:
        try:
            if panel_kaydi["var"]:
                paneli_yeniden_kur(o, lambda: xq_yaz(o, "xfce4-panel", "/panels", "dizi:int",
                                                     panel_kaydi["deger"]))
        except UygulamaHatasi as exc:
            hatalar.append(str(exc))
    return hatalar


def eksik_programlar(o):
    return [p for p in GEREKLI_PROGRAMLAR if not o.program_var(p)]


def uygula(o, cikti=print):
    eksik = eksik_programlar(o)
    if eksik:
        cikti("eksik: %s (once paketleri kurun: pkexec /usr/local/sbin/carotos-tema-kur)" % " ".join(eksik))
        return KOD_EKSIK
    try:
        onceki = yedek_oku(o)
    except UygulamaHatasi:
        cikti("yedek bozuktu, kenara alindi: %s.bozuk (yeniden calistirirsaniz yeni yedek alinir)" % o.yedek_yolu)
        return KOD_YEDEK_BOZUK
    try:
        plan = plan_olustur(o)
        yedek = yedegi_genislet(o, plan, onceki)
        yedek_yaz(o, yedek)
    except (UygulamaHatasi, OSError) as exc:
        cikti("hata (hicbir sey degismedi): %s" % exc)
        return KOD_HATA
    try:
        _uygula_plan(o, plan)
    except (UygulamaHatasi, OSError) as exc:
        hatalar = geri_yukle(o, yedek)
        if not hatalar:
            try:
                os.unlink(o.yedek_yolu)
            except OSError:
                pass
        cikti("hata: %s; ayarlar eski haline getirildi%s" % (
            exc, "" if not hatalar else " (bazi adimlar geri alinamadi: %s)" % "; ".join(hatalar)))
        return KOD_HATA
    for u in plan["uyarilar"]:
        cikti("uyari: " + u)
    cikti("uygulandi (%s)" % ("sanal makine: bulaniklik ve solma kapali" if plan["sanal"] else "gercek makine"))
    return 0


def geri_al(o, cikti=print):
    try:
        yedek = yedek_oku(o)
    except UygulamaHatasi:
        cikti("yedek bozuktu, kenara alindi: %s.bozuk" % o.yedek_yolu)
        return KOD_YEDEK_BOZUK
    if yedek is None:
        cikti("yedek yok: Carot Sleek uygulanmamis")
        return KOD_YEDEK_YOK
    hatalar = geri_yukle(o, yedek)
    if hatalar:
        cikti("bazi adimlar geri alinamadi (yedek korunuyor): " + "; ".join(hatalar))
        return KOD_HATA
    try:
        os.unlink(o.yedek_yolu)
    except OSError:
        pass
    cikti("geri alindi")
    return 0


def durum(o, cikti=print):
    try:
        yedek = yedek_oku(o)
    except UygulamaHatasi:
        yedek = None
    cikti("sleek %s" % ("uygulandi" if yedek else "uygulanmadi"))
    cikti("sanal_makine %s" % ("evet" if sanal_makine_mi(o) else "hayir"))
    eksik = eksik_programlar(o)
    cikti("eksik_program %s" % (" ".join(eksik) if eksik else "yok"))
    return 0


def main(argv=None, o=None, cikti=print):
    argv = sys.argv[1:] if argv is None else list(argv)
    if len(argv) != 1 or argv[0] not in ("uygula", "geri-al", "durum"):
        sys.stderr.write("kullanim: carotos-modernlestir uygula|geri-al|durum\n")
        return KOD_KULLANIM
    if o is None:
        if os.geteuid() == 0:
            sys.stderr.write("carotos-modernlestir: root olarak calistirmayin (kendi kullanicinizla calistirin)\n")
            return KOD_ROOT
        import pwd
        ev = pwd.getpwuid(os.getuid()).pw_dir
        o = Ortam(ev, config=os.environ.get("XDG_CONFIG_HOME"))
    return {"uygula": uygula, "geri-al": geri_al, "durum": durum}[argv[0]](o, cikti)


if __name__ == "__main__":
    sys.exit(main())
