class UygulamaHatasi(Exception):
    pass


# ---------------------------------------------------------------------------
# Ortam: dis dunyaya dokunan her sey burada (testte yerine sahtesi konur)
# ---------------------------------------------------------------------------

def temiz_ortam(c_dili=True, kaynak=None):
    kaynak = os.environ if kaynak is None else kaynak
    ortam = {k: kaynak[k] for k in ORTAM_ANAHTARLARI if k in kaynak}
    ortam["PATH"] = "/usr/bin:/bin"
    if c_dili:
        ortam["LC_ALL"] = "C"
        ortam["LANGUAGE"] = "C"
    return ortam


class Ortam:
    def __init__(self, ev, bin_dizini="/usr/bin", uygulamalar="/usr/share/applications",
                 temalar="/usr/share/themes", simgeler="/usr/share/icons", calistir=None, baslat=None,
                 program_var=None, bekle=None, dil=None, config=None):
        self.ev = ev
        self.config = config if config and os.path.isabs(config) else os.path.join(ev, ".config")
        self.durum_dizini = os.path.join(ev, ".local", "state", "carotos")
        self.yedek_yolu = os.path.join(self.durum_dizini, "sleek-yedek.json")
        self.bin_dizini = bin_dizini
        self.uygulamalar = uygulamalar
        self.temalar = temalar
        self.simgeler = simgeler
        self._calistir = calistir
        self._baslat = baslat
        self._program_var = program_var
        self.bekle = bekle or time.sleep
        lang = os.environ.get("LANG", "") if dil is None else dil
        self.dil = "tr" if lang.startswith("tr") else "en"
        self.uid = os.getuid()

    def prog(self, ad):
        return os.path.join(self.bin_dizini, ad)

    def program_var(self, ad):
        if self._program_var is not None:
            return self._program_var(ad)
        yol = self.prog(ad)
        return os.path.isfile(yol) and os.access(yol, os.X_OK)

    def calistir(self, argv, zaman=30):
        """(cikis kodu, stdout metni). Program yoksa ya da zaman asimi: (127, "")."""
        if self._calistir is not None:
            return self._calistir(list(argv))
        try:
            s = subprocess.run(argv, env=temiz_ortam(), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, timeout=zaman, check=False)
        except (OSError, subprocess.SubprocessError):
            return 127, ""
        return s.returncode, s.stdout.decode("utf-8", "replace")

    def baslat(self, argv):
        """Arka planda, oturumdan bagimsiz baslatir (picom, plank, xfce4-panel).

        Bunlar oturumun kalici parcalaridir (panelden acilan uygulamalar panelin ortamini devralir);
        bu yuzden oturum ortami korunur, yalniz kitaplik/yorumlayici enjeksiyonu degiskenleri atilir.
        Program yine tam yoluyla cagrilir; ayristirilan komutlar icin temiz_ortam() kullanilir."""
        if self._baslat is not None:
            return self._baslat(list(argv))
        ortam = {k: v for k, v in os.environ.items() if not k.startswith(("LD_", "PYTHON"))}
        try:
            subprocess.Popen(argv, env=ortam, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True,
                             start_new_session=True)
            return True
        except OSError:
            return False

    def yol(self, *parcalar):
        return os.path.join(self.config, *parcalar)


# ---------------------------------------------------------------------------
# xfconf
# ---------------------------------------------------------------------------

def xq_oku(o, kanal, ozellik):
    """(var_mi, deger). Dizi ise deger str listesi, degilse tek satir str."""
    kod, cikti = o.calistir([o.prog("xfconf-query"), "-c", kanal, "-p", ozellik])
    if kod != 0:
        return False, None
    if cikti.startswith("Value is an array"):
        govde = cikti.split("\n\n", 1)[1] if "\n\n" in cikti else ""
        return True, [s for s in govde.splitlines() if s.strip()]
    return True, cikti.rstrip("\n")


def _deger_metni(tur, deger):
    if tur == "bool":
        if isinstance(deger, bool):
            return "true" if deger else "false"
        return "true" if str(deger).strip().lower() in ("true", "1", "yes") else "false"
    return str(deger)


def xq_yaz(o, kanal, ozellik, tur, deger):
    argv = [o.prog("xfconf-query"), "-c", kanal, "-p", ozellik, "-n"]
    if tur.startswith("dizi:"):
        ogetur = tur.split(":", 1)[1]
        argv.append("-a")
        for d in deger:
            argv += ["-t", ogetur, "-s", _deger_metni(ogetur, d)]
    else:
        argv += ["-t", tur, "-s", _deger_metni(tur, deger)]
    kod, _ = o.calistir(argv)
    if kod != 0:
        raise UygulamaHatasi("xfconf yazilamadi: %s %s" % (kanal, ozellik))


def xq_sil(o, kanal, ozellik):
    o.calistir([o.prog("xfconf-query"), "-c", kanal, "-p", ozellik, "-r"])


def xq_kanal_dolu(o, kanal):
    kod, cikti = o.calistir([o.prog("xfconf-query"), "-c", kanal, "-l"])
    return kod == 0 and bool(cikti.strip())


# ---------------------------------------------------------------------------
# Dosya yardimcilari
# ---------------------------------------------------------------------------

def atomik_yaz(yol, metin, izin=0o600):
    dizin = os.path.dirname(yol)
    os.makedirs(dizin, mode=0o700, exist_ok=True)
    fd, gecici = tempfile.mkstemp(prefix=".carotos-tmp-", dir=dizin)
    try:
        os.fchmod(fd, izin)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(metin)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(gecici, yol)
    except BaseException:
        try:
            os.unlink(gecici)
        except OSError:
            pass
        raise


def oku(yol, sinir=1 << 20):
    """Dosya metni; yoksa None. Cok buyukse ya da okunamazsa UygulamaHatasi."""
    if not os.path.lexists(yol):
        return None
    if os.path.islink(yol) or not os.path.isfile(yol):
        raise UygulamaHatasi("duzenli dosya degil (sembolik bag?): %s" % yol)
    if os.path.getsize(yol) > sinir:
        raise UygulamaHatasi("dosya cok buyuk: %s" % yol)
    with open(yol, encoding="utf-8", errors="surrogateescape") as fh:
        return fh.read()


def desktop_exec_alintila(arg):
    if re.fullmatch(r"[A-Za-z0-9_@%+=:,./-]+", arg):
        return arg
    return '"' + re.sub(r'(["`$\\])', r"\\\1", arg) + '"'


def autostart_metni(ad, argv):
    exec_satiri = " ".join(desktop_exec_alintila(a) for a in argv)
    return ("[Desktop Entry]\nType=Application\nName=%s\nComment=CarotOS Sleek (carotos-modernlestir)\n"
            "Exec=%s\nOnlyShowIn=XFCE;\nNoDisplay=true\nX-GNOME-Autostart-enabled=true\n%s\n"
            % (ad, exec_satiri, DESKTOP_ISARETI))


