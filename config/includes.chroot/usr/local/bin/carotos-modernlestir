def terminalrc_ayarla(metin, anahtarlar):
    """[Configuration] bolumunde yalniz verilen anahtarlari degistirir. (yeni_metin, eski{anahtar: deger|None})."""
    satirlar = (metin or "").splitlines()
    if not any(s.strip() == "[Configuration]" for s in satirlar):
        satirlar = ["[Configuration]"] + satirlar
    eski = {k: None for k, _ in anahtarlar}
    istenen = dict(anahtarlar)
    yeni, bolum, yazilan = [], None, set()
    for s in satirlar:
        cizgi = s.strip()
        if cizgi.startswith("[") and cizgi.endswith("]"):
            if bolum == "[Configuration]":
                yeni += ["%s=%s" % (k, v) for k, v in anahtarlar if k not in yazilan]
                yazilan.update(istenen)
            bolum = cizgi
            yeni.append(s)
            continue
        if bolum == "[Configuration]" and "=" in s:
            k = s.split("=", 1)[0].strip()
            if k in istenen:
                if k not in yazilan:
                    eski[k] = s.split("=", 1)[1]
                    yeni.append("%s=%s" % (k, istenen[k]))
                    yazilan.add(k)
                continue                    # yinelenen anahtar satiri atilir
        yeni.append(s)
    if bolum == "[Configuration]":
        yeni += ["%s=%s" % (k, v) for k, v in anahtarlar if k not in yazilan]
    return "\n".join(yeni) + "\n", eski


def terminalrc_geri(metin, eski):
    """Yalniz bizim anahtarlar: eski degeri olan geri yazilir, olmayan satir silinir."""
    if metin is None:
        return None
    satirlar, yeni, bolum, yazilan = metin.splitlines(), [], None, set()
    for s in satirlar:
        cizgi = s.strip()
        if cizgi.startswith("[") and cizgi.endswith("]"):
            bolum = cizgi
            yeni.append(s)
            continue
        if bolum == "[Configuration]" and "=" in s:
            k = s.split("=", 1)[0].strip()
            if k in eski:
                if eski[k] is not None and k not in yazilan:
                    yeni.append("%s=%s" % (k, eski[k]))
                    yazilan.add(k)
                continue
        yeni.append(s)
    return "\n".join(yeni) + "\n"


