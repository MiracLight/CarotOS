def picom_conf(sanal):
    """picom 10..12.5 ile uyumlu eski tip anahtarlar ("rules" kullanilmaz, karistirilmaz)."""
    tam_ekran = "\"_NET_WM_STATE@:32a *= '_NET_WM_STATE_FULLSCREEN'\""
    s = [
        "# CarotOS \"Carot Sleek\" picom ayarlari (carotos-modernlestir uretti).",
        "# Geri almak icin: carotos-modernlestir geri-al",
        "# Mod: %s" % ("sanal makine (xrender, bulaniklik ve solma kapali)" if sanal
                       else "gercek makine (glx, bulaniklik ve solma acik)"),
        "",
        'backend = "%s";' % ("xrender" if sanal else "glx"),
        "vsync = %s;" % ("false" if sanal else "true"),
        "use-damage = true;",
        "detect-rounded-corners = true;",
        "detect-client-opacity = true;",
        "detect-transient = true;",
        "mark-wmwin-focused = true;",
        "mark-ovredir-focused = true;",
        "",
        "corner-radius = 12;",
        "rounded-corners-exclude = [",
        "  \"window_type = 'dock'\",",
        "  \"window_type = 'desktop'\",",
        "  \"class_g = 'Plank'\",",
        "  \"class_g = 'Xfdesktop'\",",
        "  " + tam_ekran,
        "];",
        "",
        "shadow = true;",
        "shadow-radius = 24;",
        "shadow-opacity = 0.35;",
        "shadow-offset-x = -24;",
        "shadow-offset-y = -16;",
        "shadow-exclude = [",
        "  \"window_type = 'dock'\",",
        "  \"window_type = 'desktop'\",",
        "  \"window_type = 'dnd'\",",
        "  \"class_g = 'Plank'\",",
        "  \"class_g = 'Xfdesktop'\",",
        "  \"_GTK_FRAME_EXTENTS@:c\",",
        "  " + tam_ekran,
        "];",
        "",
    ]
    if sanal:
        s += ["fading = false;", "blur-background = false;", ""]
    else:
        s += [
            "fading = true;",
            "fade-in-step = 0.03;",
            "fade-out-step = 0.03;",
            "fade-delta = 5;",
            "",
            "# Bulaniklik yalniz yari saydam panel, dock, menu, bildirim, terminal ve rofi icin",
            'blur-method = "dual_kawase";',
            "blur-strength = 6;",
            "blur-background = true;",
            "blur-background-frame = false;",
            "blur-background-fixed = false;",
            "blur-background-exclude = [",
            "  \"window_type = 'desktop'\",",
            "  \"window_type = 'dnd'\",",
            "  \"window_type = 'tooltip'\",",
            "  \"window_type = 'splash'\",",
            "  \"window_type = 'utility'\",",
            "  \"window_type = 'dialog'\",",
            "  \"window_type = 'normal' && class_g != 'Xfce4-terminal' && class_g != 'Rofi'\",",
            "  \"_GTK_FRAME_EXTENTS@:c\"",
            "];",
            "",
        ]
    s += [
        "wintypes:",
        "{",
        "  tooltip = { fade = true; shadow = false; };",
        "  dock = { shadow = false; };",
        "  dnd = { shadow = false; };",
        "};",
        "",
    ]
    return "\n".join(s)


def css_blogu():
    return "\n".join([
        CSS_BAS,
        "/* carotos-modernlestir ekledi; geri al yalniz bu blogu siler. */",
        ".xfce4-panel.panel,",
        "#XfcePanelWindow {",
        "  background-color: rgba(0, 18, 57, 0.75);",
        "  border: none;",
        "}",
        ".xfce4-panel button { border-radius: 8px; }",
        ".xfce4-panel #tasklist-button:checked,",
        ".xfce4-panel button:checked { border-bottom: 2px solid %s; }" % RENK_VURGU,
        "menu, .menu, .context-menu { border-radius: 12px; padding: 6px; }",
        "menu menuitem, .menu menuitem { border-radius: 8px; padding: 6px 10px; }",
        "#whiskermenu-window { border-radius: 14px; }",
        "#whiskermenu-window entry { border-radius: 10px; padding: 6px 10px; }",
        "#whiskermenu-window button { border-radius: 8px; }",
        CSS_SON,
    ]) + "\n"


_BLOK = re.compile(r"\n?" + re.escape(CSS_BAS) + r".*?" + re.escape(CSS_SON) + r"[ \t]*\n?", re.S)


def css_blok_ekle(metin, blok):
    """Mevcut icerik korunur; bizim blok varsa yerine konur, yoksa sona eklenir."""
    metin = metin or ""
    if CSS_BAS in metin and CSS_SON not in metin:
        raise UygulamaHatasi("gtk.css icinde yarim CarotOS blogu var; elle duzeltin")
    temiz = css_blok_kaldir(metin)
    if temiz and not temiz.endswith("\n"):
        temiz += "\n"
    return temiz + ("\n" if temiz else "") + blok


def css_blok_kaldir(metin):
    if not metin:
        return metin
    if CSS_BAS in metin and CSS_SON not in metin:
        return metin                       # yarim blok: dokunma
    # css_blok_ekle blogun onune bir bos satir koyar: o satir da blokla birlikte kalkar
    return _BLOK.sub("", metin, count=1)


