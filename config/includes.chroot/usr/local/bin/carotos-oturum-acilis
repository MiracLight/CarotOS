#!/usr/bin/env python3
"""CarotOS oturum acilis perdesi.

LightDM girisinden sonra masaustu hazir olana kadar gecen surede siyah ekran
yerine CarotOS logosunu gosterir. Masaustu (xfdesktop) ve panel calismaya
basladiktan sonra kendini yumusakca kapatir.

Tasarim ilkeleri (kararlilik ve dusuk bellek):
  * Pencere "override-redirect" (POPUP) turundedir: pencere yoneticisi
    (xfwm4) henuz baslamamis olsa da tam ekran ve en ustte kalir.
  * Solma animasyonu icin ekran birlestirici (compositor) gerekmez; logo
    onceden beyaz zemine karistirilmis birkac kareden olusur.
  * Hazirlik kontrolu surec baslatmaz, /proc dizinini okur ve saniyede
    yalnizca birkac kez calisir.
  * Her turlu hatada sessizce cikar; kesin sure asiminda kendini sonlandirir.

Ortam degiskenleri:
  CAROTOS_ACILIS_KAPALI=1   perdeyi hic gosterme
"""
import os
import signal
import sys
import time

LOGO_ADAYLARI = [
    "/usr/share/carotos/acilis-logo.png",
    "/usr/share/carotos/welcome/logo.png",
    "/usr/share/carotos/logo.png",
]
SURE_EN_AZ = 2.0       # saniye: perde en az bu kadar gorunur
SURE_EN_COK = 14.0     # saniye: masaustu gelmese bile bu surede kapanir
HAZIR_SONRASI = 2.0    # panel/masaustu goruldukten sonra: duvar kagidinin cizilmesini bekle
KARE_MS = 80           # animasyon adimi
GIRIS_KARE = 8         # belirme kare sayisi
CIKIS_KARE = 5         # solma kare sayisi
KONTROL_ADIM = 5       # hazirlik kontrolu: her 5 adimda bir (~0,4 sn)
NOKTA_ADIM = 6         # yukleniyor noktalari: her 6 adimda bir
BEKLENEN = ("xfdesktop", "xfce4-panel")


def calisanlar():
    """Calisan sureclerin kisa adlarini /proc'tan okur (surec baslatmaz)."""
    adlar = set()
    try:
        for d in os.listdir("/proc"):
            if d.isdigit():
                try:
                    with open("/proc/%s/comm" % d) as f:
                        adlar.add(f.read().strip())
                except OSError:
                    continue
    except OSError:
        pass
    return adlar


def main():
    if os.environ.get("CAROTOS_ACILIS_KAPALI") == "1":
        return 0
    if not os.environ.get("DISPLAY"):
        return 0

    # Ne olursa olsun bu sure sonunda surec sonlanir (SIGALRM varsayilani).
    signal.alarm(int(SURE_EN_COK) + 4)

    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import Gdk, GdkPixbuf, GLib, Gtk
    except Exception:
        return 0

    ekran = Gdk.Screen.get_default()
    if ekran is None:
        return 0
    gen, yuk = ekran.get_width(), ekran.get_height()

    test = os.environ.get("CAROTOS_ACILIS_TEST")          # test: sabit sure
    goruntu = os.environ.get("CAROTOS_ACILIS_GORUNTU")    # test: ekran goruntusu

    # Logo ve belirme/solma kareleri
    giris = []
    logo = None
    yol = next((y for y in LOGO_ADAYLARI if os.path.isfile(y)), None)
    if yol:
        try:
            h = max(150, min(320, int(yuk * 0.26)))
            logo = GdkPixbuf.Pixbuf.new_from_file_at_scale(yol, -1, h, True)
            for i in range(GIRIS_KARE):
                a = (i + 1) / float(GIRIS_KARE)
                giris.append(logo.composite_color_simple(
                    logo.get_width(), logo.get_height(),
                    GdkPixbuf.InterpType.NEAREST, int(255 * a), 16,
                    0xffffff, 0xffffff))
        except GLib.Error:
            giris = []
    cikis = []
    if giris:
        for i in range(CIKIS_KARE):
            idx = int((GIRIS_KARE - 1) * (1 - (i + 1) / float(CIKIS_KARE + 1)))
            cikis.append(giris[idx])

    css = (
        "window.acilis { background-color: #ffffff; }"
        ".acilis-yazi { color: #185fa5; font-size: 34px; font-weight: bold;"
        " letter-spacing: 3px; }"
        ".acilis-nokta { color: #3b8bde; font-size: 26px; letter-spacing: 6px; }"
    )
    saglayici = Gtk.CssProvider()
    saglayici.load_from_data(css.encode())
    Gtk.StyleContext.add_provider_for_screen(
        ekran, saglayici, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    # POPUP = override-redirect: pencere yoneticisi gerekmez.
    pencere = Gtk.Window(type=Gtk.WindowType.POPUP)
    pencere.get_style_context().add_class("acilis")
    pencere.set_default_size(gen, yuk)
    pencere.move(0, 0)

    kutu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    kutu.set_halign(Gtk.Align.CENTER)
    kutu.set_valign(Gtk.Align.CENTER)
    resim = None
    if giris:
        resim = Gtk.Image.new_from_pixbuf(giris[0])
        kutu.pack_start(resim, False, False, 0)
    else:
        yazi = Gtk.Label(label="CarotOS")
        yazi.get_style_context().add_class("acilis-yazi")
        kutu.pack_start(yazi, False, False, 0)
    noktalar = Gtk.Label(label="●  ○  ○")
    noktalar.get_style_context().add_class("acilis-nokta")
    kutu.pack_start(noktalar, False, False, 0)
    pencere.add(kutu)

    baslangic = time.monotonic()
    d = {"adim": 0, "faz": "giris", "hazir_an": None, "cikis_i": 0,
         "goruntu": False}
    nokta_dizi = ["●  ○  ○", "○  ●  ○",
                  "○  ○  ●"]

    def bitir():
        Gtk.main_quit()
        return False

    def adim():
        d["adim"] += 1
        n = d["adim"]
        t = time.monotonic() - baslangic

        if d["faz"] == "giris":
            if resim is not None and n <= GIRIS_KARE:
                resim.set_from_pixbuf(giris[n - 1])
            if n >= GIRIS_KARE:
                d["faz"] = "bekle"
            return True

        if d["faz"] == "cikis":
            i = d["cikis_i"]
            if i >= len(cikis):
                return bitir()
            if resim is not None:
                resim.set_from_pixbuf(cikis[i])
            noktalar.set_opacity(0.0)
            d["cikis_i"] = i + 1
            return True

        # faz == "bekle"
        if n % NOKTA_ADIM == 0:
            noktalar.set_text(nokta_dizi[(n // NOKTA_ADIM) % 3])

        if goruntu and not d["goruntu"] and t > 1.2:
            d["goruntu"] = True
            try:
                pb = Gdk.pixbuf_get_from_window(
                    pencere.get_window(), 0, 0,
                    pencere.get_allocated_width(),
                    pencere.get_allocated_height())
                if pb is not None:
                    pb.savev(goruntu, "png", [], [])
            except Exception:
                pass

        if n % KONTROL_ADIM == 0:
            try:
                pencere.get_window().raise_()     # en ustte kal
            except Exception:
                pass
            if test:
                gecti = t >= float(test)
            else:
                var = calisanlar()
                if all(a in var for a in BEKLENEN) and d["hazir_an"] is None:
                    d["hazir_an"] = time.monotonic()
                gecti = (t >= SURE_EN_AZ and d["hazir_an"] is not None
                         and time.monotonic() - d["hazir_an"] >= HAZIR_SONRASI)
                if t >= SURE_EN_COK:
                    gecti = True
            if gecti:
                d["faz"] = "cikis"
        return True

    GLib.timeout_add(KARE_MS, adim)
    pencere.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
