#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""CarotOS Komut Açıklayıcı (komut satırı): bir komutu ÇALIŞTIRMADAN açıklar.

Kullanım:
  carotos-acikla [--dil KOD] <komut ve argümanları…>
  carotos-acikla [--dil KOD] --satir "<tüm satır>"      (Alt+E bağlantısı bunu kullanır)
  echo "sudo ufw status" | carotos-acikla               (satır stdin'den)

Komutu hiçbir zaman çalıştırmaz; yalnızca ayrıştırır. Hiçbir şey ağa gönderilmez.
"""
import os
import shlex
import sys

sys.dont_write_bytecode = True
try:
    # Komut satırında geçersiz UTF-8 baytı olsa da (surrogateescape) yazarken çökmesin (A-09)
    sys.stdout.reconfigure(errors="backslashreplace")
except (AttributeError, ValueError):
    pass
_BURASI = os.path.dirname(os.path.abspath(__file__))
for _yol in ("/opt/carotos/acikla", os.path.join(_BURASI, "..", "..", "..", "opt", "carotos", "acikla")):
    if os.path.isdir(_yol):
        sys.path.insert(0, os.path.abspath(_yol))
        break

import acikla_motor  # noqa: E402


def main(argv):
    kod = None
    kalan = list(argv)
    if kalan and kalan[0] == "--dil" and len(kalan) >= 2:
        kod, kalan = kalan[1], kalan[2:]
    if kalan and kalan[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if kalan and kalan[0] == "--satir":
        satir = " ".join(kalan[1:])
    elif len(kalan) == 1:
        satir = kalan[0]                    # tek argüman: bütün satır (carotos-acikla "ls | grep x")
    elif kalan:
        # Kabuk tırnakları zaten açtı; yeniden tırnaklayarak birleştir ki `echo 'a; b'` iki parça görünmesin (A-10)
        satir = shlex.join(kalan)
    elif not sys.stdin.isatty():
        try:
            sys.stdin.reconfigure(errors="replace")     # geçersiz UTF-8 çökertmesin (A-09)
        except (AttributeError, ValueError):
            pass
        satir = sys.stdin.read(acikla_motor.SINIR_KARAKTER + 1).strip()
    else:
        print(__doc__.strip())
        return 0
    sys.stdout.write(acikla_motor.acikla(satir, kod))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
