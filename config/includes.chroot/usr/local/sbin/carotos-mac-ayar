#!/usr/bin/python3 -I
# -*- coding: utf-8 -*-
"""CarotOS: "her ag icin farkli sahte MAC adresi" anahtari (root olarak, pkexec ile cagrilir).

Kullanim:  carotos-mac-ayar ac | kapat | durum

  ac     /etc/NetworkManager/conf.d/91-carotos-mac.conf dosyasini yazar (wifi ve ethernet icin
         cloned-mac-address=stable) ve NetworkManager yapilandirmasini yeniden okutur
  kapat  o dosyayi siler (donanimin gercek adresi kullanilir) ve yeniden okutur
  durum  "ac" ya da "kapali" yazar

Varsayilan KAPALI'dir: MAC adresine gore izin veren aglarda (okul, ofis, bazi modemler) sahte adres
baglanti kurdurmaz. Dosya icerigi sabittir; hicbir arguman dosyaya yazilmaz. Yalniz bu tek dosya
degistirilir; baska hicbir sistem dosyasina dokunulmaz. Kabuk kullanilmaz.
"""
import os
import subprocess
import sys

DIZIN = "/etc/NetworkManager/conf.d"
AD = "91-carotos-mac.conf"
ICERIK = """# CarotOS: her ag icin farkli (ama o agda hep ayni) sahte donanim adresi (MAC).
# Karsilama > Ag ve gizlilik anahtariyla yonetilir; elle silmek anahtarin kapatilmasi demektir.
# Not: MAC adresine gore izin veren aglarda gercek adres gerekir; anahtari kapatin.
[connection]
wifi.cloned-mac-address=stable
ethernet.cloned-mac-address=stable
"""
ORTAM = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}
KOMUTLAR = ("ac", "kapat", "durum")


def yol(kok=""):
    return os.path.join(kok + DIZIN, AD)


def ac(kok=""):
    hedef = yol(kok)
    os.makedirs(os.path.dirname(hedef), exist_ok=True)
    gecici = hedef + ".yeni"                       # dizin yalniz root'a ait; bayrak sembolik baglanti izlemez
    fd = os.open(gecici, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(ICERIK)
        os.fchmod(f.fileno(), 0o644)
    os.replace(gecici, hedef)


def kapat(kok=""):
    try:
        os.unlink(yol(kok))
    except FileNotFoundError:
        pass


def durum(kok=""):
    return "ac" if os.path.isfile(yol(kok)) else "kapali"


def yeniden_oku():
    subprocess.run(["nmcli", "general", "reload", "conf"], env=ORTAM, timeout=20, check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main(argv, kok=""):
    if len(argv) != 2 or argv[1] not in KOMUTLAR:
        print("kullanim: carotos-mac-ayar ac|kapat|durum", file=sys.stderr)
        return 2
    komut = argv[1]
    if komut == "durum":
        print(durum(kok))
        return 0
    if not kok and os.geteuid() != 0:
        print("root gerekli (pkexec ile calistirin)", file=sys.stderr)
        return 3
    if komut == "ac":
        ac(kok)
    else:
        kapat(kok)
    if not kok:
        try:
            yeniden_oku()
        except (OSError, subprocess.SubprocessError):
            pass                                   # dosya yazildi; yeni baglantilarda ya da yeniden baslatmada gecerli olur
    print(durum(kok))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
