#!/bin/sh
set -e
DOSYA="/usr/lib/live/init-config.sh"
if [ -f "$DOSYA" ]; then
    sed -i 's/LIVE_USER_FULLNAME="Debian Live user"/LIVE_USER_FULLNAME="CarotOS Live User"/' "$DOSYA"
    echo "CarotOS: Live User adi guncellendi."
else
    echo "CarotOS UYARI: $DOSYA bulunamadi, Live User adi degistirilemedi." >&2
fi
