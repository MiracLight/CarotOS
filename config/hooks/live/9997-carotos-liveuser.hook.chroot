#!/bin/sh
set -e
DOSYA="/usr/lib/live/init-config.sh"
if [ -f "$DOSYA" ]; then
    sed -i 's/LIVE_USER_FULLNAME="Debian Live user"/LIVE_USER_FULLNAME="CarotOS Live User"/' "$DOSYA"
    sed -i 's/LIVE_HOSTNAME="debian"/LIVE_HOSTNAME="carotos"/' "$DOSYA"
    # sed eslesmese bile 0 doner; sonucu dogrula, yoksa derleme dursun
    grep -q 'LIVE_HOSTNAME="carotos"' "$DOSYA" || { echo "CarotOS HATA: $DOSYA icinde LIVE_HOSTNAME carotos olmadi." >&2; exit 1; }
    grep -q 'LIVE_USER_FULLNAME="CarotOS Live User"' "$DOSYA" || { echo "CarotOS HATA: $DOSYA icinde Live User adi degismedi." >&2; exit 1; }
    echo "CarotOS: Live User adi guncellendi."
else
    # live-config dosyanin yerini degistirdiyse sessizce "Debian Live user" adiyla cikmasin
    echo "CarotOS HATA: $DOSYA bulunamadi, Live User adi degistirilemedi." >&2
    exit 1
fi
