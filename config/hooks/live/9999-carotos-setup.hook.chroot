#!/bin/sh
set -e

echo "CarotOS kurulum betiği çalışıyor..."

# İzinleri düzelt
chmod 755 /opt/carotos/security-panel/carotos-security-panel.py
chmod 755 /usr/local/bin/nikto
chmod 644 /usr/share/backgrounds/carotos/*.png /usr/share/backgrounds/login.png
chmod 644 /usr/share/backgrounds/login.png
chmod 644 /usr/share/icons/carotos/security-panel-icon.png
chmod 644 /usr/share/carotos/carotos_ascii.txt
chmod 644 /usr/share/applications/carotos-security-panel.desktop

# Firefox'u varsayılan tarayıcı yap
# www-browser metin tarayicilarina ayrilmistir, firefox-esr onu saglamaz;
# yalnizca x-www-browser ayarlanir. Hata olursa derleme dursun.
update-alternatives --set x-www-browser /usr/bin/firefox-esr

# fail2ban'ı açılışta otomatik başlat
systemctl enable fail2ban

# ModemManager varsayilan KAPALI: cogu bilgisayarda mobil (4G/LTE) modem yok, servis bosuna bellek
# tutuyor. Disable D-Bus takma adini da kaldirir, yani kendiliginden de baslatilmaz. Kullanici
# Sistem Sagligi > Bellek kartindaki dugmeyle acar (systemctl enable --now). Karar sessizce bozulmasin.
if [ -e /usr/lib/systemd/system/ModemManager.service ] || [ -e /lib/systemd/system/ModemManager.service ]; then
    systemctl disable ModemManager.service
    if systemctl is-enabled --quiet ModemManager.service 2>/dev/null; then
        echo "CarotOS HATA: ModemManager.service hala etkin." >&2
        exit 1
    fi
    echo "CarotOS: ModemManager varsayilan olarak kapatildi."
fi

# Not: derleme aninda UID >= 1000 kullanici yoktur; ilk kullanicinin yetkisi
# kurucu (preseed, passwd/root-login false) ve carotos-firstboot ile verilir.

# Sistem kimligi: hardinfo2 (ve benzer araclar) once /usr/lib/os-release'i okur, /etc/os-release'i yalniz CachyOS icin kullanir.
# Debian'in dosyasi orada kaldigi icin "Debian" gorunuyordu. Dosya CarotOS'unkiyle degistirilir; dpkg-divert ile
# base-files guncellemesi onu geri almaz (yeni Debian dosyasi os-release.debian olarak yanina yazilir).
if [ -f /etc/os-release ] && grep -q '^ID=carotos' /etc/os-release; then
    cp /etc/os-release /usr/lib/os-release.carotos
    dpkg-divert --local --rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release
    mv /usr/lib/os-release.carotos /usr/lib/os-release
    chmod 644 /usr/lib/os-release
    grep -q '^ID=carotos' /usr/lib/os-release || { echo "CarotOS HATA: /usr/lib/os-release CarotOS kimligini tasimiyor." >&2; exit 1; }
    echo "CarotOS: /usr/lib/os-release CarotOS kimligine ayarlandi (dpkg-divert)."
fi

echo "CarotOS kurulum betiği tamamlandı."

# İlk açılış servisi (kurulum sonrası sudo düzeltmesi)
chmod 755 /usr/local/sbin/carotos-firstboot.sh
chmod 755 /usr/sbin/carotos-dil-hazirla
chmod 755 /usr/sbin/carotos-mac-ayar
chmod 755 /usr/sbin/carotos-ufw-ayar
chmod 755 /usr/sbin/carotos-magaza-apt
chmod 755 /usr/sbin/carotos-tema-kur
chmod 755 /usr/bin/carotos-modernlestir
chmod 755 /usr/bin/carotos-saat-eslestir
chmod 755 /usr/bin/carotos-acikla
# Yardimci betikler /usr/sbin ve /usr/bin altindadir (paketlerle ayni yer); includes.chroot dosyalarinin kipi ve
# sahibi derleme klonundan gelir, root'a ait ve yalnizca root'ca yazilabilir olmali.
for yol in /usr/sbin/carotos-dil-hazirla /usr/sbin/carotos-mac-ayar /usr/sbin/carotos-ufw-ayar /usr/sbin/carotos-magaza-apt            /usr/sbin/carotos-tema-kur /usr/bin/carotos-modernlestir /usr/bin/carotos-saat-eslestir /usr/bin/carotos-acikla; do
    [ -f "$yol" ] || { echo "CarotOS HATA: $yol yok." >&2; exit 1; }
    chown root:root "$yol"
    chmod 755 "$yol"
done
chmod 644 /usr/share/carotos/acikla.bash
# Komut Aciklayici (Alt+E): etkilesimli bash'e baglanti (yinelenmez)
if ! grep -q 'carotos/acikla.bash' /etc/bash.bashrc; then
    printf '\n# CarotOS Komut Aciklayici (Alt+E)\n[ -r /usr/share/carotos/acikla.bash ] && . /usr/share/carotos/acikla.bash\n' >> /etc/bash.bashrc
fi
grep -q 'carotos/acikla.bash' /etc/bash.bashrc || { echo "CarotOS HATA: /etc/bash.bashrc Komut Aciklayici baglantisini icermiyor." >&2; exit 1; }
chmod 644 /etc/skel/.config/autostart/carotos-saat-eslestir.desktop
chmod 644 /etc/systemd/system/carotos-firstboot.service
systemctl enable carotos-firstboot.service
echo "CarotOS: firstboot servisi etkinlestirildi."

# Karşılama sihirbazı
chmod 755 /opt/carotos/welcome/carotos-welcome.py
chmod 644 /usr/share/applications/carotos-welcome.desktop
chmod 644 /etc/skel/.config/autostart/carotos-welcome-autostart.desktop
echo "CarotOS: karsilama sihirbazi yerlestirildi."

# Sistem Sağlığı uygulaması
chmod 755 /opt/carotos/health/carotos-health.py
chmod 644 /usr/share/applications/carotos-health.desktop
echo "CarotOS: sistem sagligi yerlestirildi."

# Yerel ayarlar (Türkçe varsayılan, İngilizce de mevcut). Üretilemezse ISO
# bozuk dil ayarıyla çıkardı: derleme durur.
[ -x /usr/sbin/locale-gen ] || { echo "CarotOS HATA: locale-gen yok (paket listesinde 'locales' olmali)." >&2; exit 1; }
/usr/sbin/locale-gen
locale -a | grep -qi '^tr_TR\.utf-\{0,1\}8$' || { echo "CarotOS HATA: tr_TR.UTF-8 yerel ayari uretilmedi." >&2; exit 1; }
echo "CarotOS: yerel ayarlar uretildi."

# Simge önbelleğini tazele (isteğe bağlı: başarısızlık yalnızca bellek kullanımını artırır)
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
echo "CarotOS: simge onbellegi tazelendi."

# USB Denetimi (otomatik başlatıcısı /etc/xdg/autostart/carotos-usb-check.desktop)
chmod 755 /opt/carotos/usb/carotos-usb-check.py
chmod 755 /opt/carotos/yanpanel/carotos-yanpanel.py
chmod 644 /usr/share/applications/carotos-usb-check.desktop
chmod 644 /etc/xdg/autostart/carotos-usb-check.desktop
echo "CarotOS: usb denetimi yerlestirildi."

# CarotOS paket deposu (apt.carotos.org): imza anahtari ve depo tanimi config/packages.chroot'taki
# carotos-archive-keyring paketiyle gelir (dpkg sahipli; elle kopyalanmaz). Sessizce eksik kalmasin.
dpkg -s carotos-archive-keyring 2>/dev/null | grep -q '^Status: install ok installed' \
    || { echo "CarotOS HATA: carotos-archive-keyring kurulmadi (config/packages.chroot)." >&2; exit 1; }
[ -s /usr/share/keyrings/carotos-archive-keyring.gpg ] && [ -s /etc/apt/sources.list.d/carotos.sources ] \
    || { echo "CarotOS HATA: depo anahtari ya da carotos.sources eksik." >&2; exit 1; }
echo "CarotOS: paket deposu tanimi yerlestirildi (apt.carotos.org)."

# Sahiplik ve izinler: includes.chroot dosyalarinin kipi derleme klonundan gelir
# (umask 002 ile alinmis klonda grup-yazilabilir). Root'un calistirdigi ya da
# okudugu CarotOS dosyalari root'a ait ve yalnizca root'ca yazilabilir olmali
# (carotos-dil-hazirla, pkexec betikleri, systemd birimleri, oturum betikleri).
for yol in /opt/carotos /usr/local/bin /usr/local/sbin /usr/share/carotos \
           /etc/systemd/system /etc/grub.d /etc/default/grub.d /etc/X11/Xsession.d \
           /etc/xdg/autostart /etc/skel /etc/carotpot /etc/live/config.conf.d \
           /etc/calamares /usr/share/calamares; do
    [ -e "$yol" ] || continue
    chown -R -h root:root "$yol"
    chmod -R go-w "$yol"
done
KOTU="$(find /opt/carotos /usr/local/bin /usr/local/sbin /usr/share/carotos /etc/systemd/system \
        /etc/grub.d /etc/default/grub.d /etc/X11/Xsession.d /etc/calamares /usr/share/calamares \
        -xdev ! -type l \
        \( -perm /022 -o ! -user root \) -print 2>/dev/null | head -n 5)"
[ -z "$KOTU" ] || { echo "CarotOS HATA: root disinda yazilabilir dosya kaldi: $KOTU" >&2; exit 1; }
echo "CarotOS: sahiplik ve izinler denetlendi (root, go-w)."
