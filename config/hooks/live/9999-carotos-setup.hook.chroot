#!/bin/sh
set -e

echo "CarotOS kurulum betiği çalışıyor..."

# İzinleri düzelt
chmod 755 /opt/carotos/security-panel/carotos-security-panel.py
chmod 755 /usr/local/bin/nikto
chmod 644 /usr/share/backgrounds/carotos/*.png /usr/share/backgrounds/login.png
chmod 644 /usr/share/backgrounds/login.png
chmod 644 /usr/share/icons/carotos/security-panel-icon.png
chmod 644 /usr/share/carotos/carotos_ascii.txt
chmod 644 /usr/share/applications/carotos-security-panel.desktop

# GRUB'ı güncelle (CarotOS adının menüde görünmesi için)


# Firefox'u varsayılan tarayıcı yap
# www-browser metin tarayicilarina ayrilmistir, firefox-esr onu saglamaz;
# yalnizca x-www-browser ayarlanir. Hata olursa derleme dursun.
update-alternatives --set x-www-browser /usr/bin/firefox-esr

# fail2ban'ı açılışta otomatik başlat
systemctl enable fail2ban

# İlk kullanıcıyı otomatik sudo yetkili yap
if [ -n "$(getent group sudo)" ]; then
    for u in $(awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' /etc/passwd); do
        usermod -aG sudo "$u" || true
    done
fi

# Sistem kimligi: hardinfo2 (ve benzer araclar) once /usr/lib/os-release'i okur, /etc/os-release'i yalniz CachyOS icin kullanir.
# Debian'in dosyasi orada kaldigi icin "Debian" gorunuyordu. Dosya CarotOS'unkiyle degistirilir; dpkg-divert ile
# base-files guncellemesi onu geri almaz (yeni Debian dosyasi os-release.debian olarak yanina yazilir).
if [ -f /etc/os-release ] && grep -q '^ID=carotos' /etc/os-release; then
    cp /etc/os-release /usr/lib/os-release.carotos
    dpkg-divert --local --rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release
    mv /usr/lib/os-release.carotos /usr/lib/os-release
    chmod 644 /usr/lib/os-release
    grep -q '^ID=carotos' /usr/lib/os-release || { echo "CarotOS HATA: /usr/lib/os-release CarotOS kimligini tasimiyor." >&2; exit 1; }
    echo "CarotOS: /usr/lib/os-release CarotOS kimligine ayarlandi (dpkg-divert)."
fi

echo "CarotOS kurulum betiği tamamlandı."

# İlk açılış servisi (kurulum sonrası sudo düzeltmesi)
chmod 755 /usr/local/sbin/carotos-firstboot.sh
chmod 755 /usr/local/sbin/carotos-dil-hazirla
chmod 755 /usr/local/bin/carotos-saat-eslestir
chmod 755 /usr/local/bin/carotos-acikla
chmod 644 /usr/share/carotos/acikla.bash
# Komut Aciklayici (Alt+E): etkilesimli bash'e baglanti (yinelenmez)
if ! grep -q 'carotos/acikla.bash' /etc/bash.bashrc; then
    printf '\n# CarotOS Komut Aciklayici (Alt+E)\n[ -r /usr/share/carotos/acikla.bash ] && . /usr/share/carotos/acikla.bash\n' >> /etc/bash.bashrc
fi
grep -q 'carotos/acikla.bash' /etc/bash.bashrc || { echo "CarotOS HATA: /etc/bash.bashrc Komut Aciklayici baglantisini icermiyor." >&2; exit 1; }
chmod 644 /etc/skel/.config/autostart/carotos-saat-eslestir.desktop
chmod 644 /etc/systemd/system/carotos-firstboot.service
systemctl enable carotos-firstboot.service
echo "CarotOS: firstboot servisi etkinlestirildi."

# Karşılama sihirbazı
chmod 755 /opt/carotos/welcome/carotos-welcome.py || true
chmod 644 /usr/share/applications/carotos-welcome.desktop || true
chmod 644 /etc/skel/.config/autostart/carotos-welcome-autostart.desktop || true
echo "CarotOS: karsilama sihirbazi yerlestirildi."

# Sistem Sağlığı uygulaması
chmod 755 /opt/carotos/health/carotos-health.py || true
chmod 644 /usr/share/applications/carotos-health.desktop || true
echo "CarotOS: sistem sagligi yerlestirildi."

# Yerel ayarlar (Türkçe varsayılan, İngilizce de mevcut)
if [ -x /usr/sbin/locale-gen ]; then
    /usr/sbin/locale-gen || true
    echo "CarotOS: yerel ayarlar uretildi."
fi

# Simge önbelleğini tazele
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
echo "CarotOS: simge onbellegi tazelendi."

# USB Denetimi
chmod 755 /opt/carotos/usb/carotos-usb-check.py || true
chmod 644 /usr/share/applications/carotos-usb-check.desktop || true
chmod 644 /etc/skel/.config/autostart/carotos-usb-monitor.desktop || true
echo "CarotOS: usb denetimi yerlestirildi."
