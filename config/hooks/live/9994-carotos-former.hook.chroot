#!/bin/sh
set -e

# CarotOS Former (guvenlik uygulamalari rehberi).
# - Arayuz ve canli Cairo animasyonlari icin python3-gi-cairo (ortak tema ile
#   ayni gereksinim: CarotPot 2, Filenor).
LC_ALL=C DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3-gi-cairo

chmod 755 /opt/carotos/former/carotos-former.py
find /opt/carotos/former -name '*.py' ! -name 'carotos-former.py' -exec chmod 644 {} +
# PNG simgeler yama icinde metin (base64) olarak tasinir; burada acilir.
# (Satir bicimi: "<boyut> <base64>"; vektor surum scalable/ altinda hazir durur.)
while read -r boyut veri; do
    [ -n "$boyut" ] || continue
    mkdir -p "/usr/share/icons/hicolor/${boyut}x${boyut}/apps"
    printf '%s' "$veri" | base64 -d > "/usr/share/icons/hicolor/${boyut}x${boyut}/apps/carotos-former.png"
done < /opt/carotos/former/ikonlar.b64
rm -f /opt/carotos/former/ikonlar.b64
chmod 644 /usr/share/applications/carotos-former.desktop /usr/share/icons/hicolor/*/apps/carotos-former.png /usr/share/icons/hicolor/scalable/apps/carotos-former.svg
ln -sf /opt/carotos/former/carotos-former.py /usr/local/bin/carotos-former
gtk-update-icon-cache -f -t /usr/share/icons/hicolor || true
update-desktop-database /usr/share/applications || true
echo "CarotOS: Former yerlestirildi."
