# CarotOS 1.4: canli masaustunden Calamares kurulumu (docs/CALAMARES_ARASTIRMA.md)
# d-i (onyukleme menusu) yedek olarak kalir. shim-signed ve grub-efi-amd64-signed
# BURAYA EKLENMEZ (BUILD.md "Secure Boot ve UEFI").
# Calamares + moduller + Debian yardimci betikleri (calamares, cryptsetup, keyutils, pkexec, rsync ...)
calamares-settings-debian
# users modulu sudoersGroup: sudo yazar; live-config kurulumdan sonra kaldirilinca sudo "otomatik kurulu"
# kalip silinmesin diye elle de listelenir
sudo
# carotos-kur xhost kullanir (Calamares root olarak X'e baglanir)
x11-xserver-utils
# Qt 6.5+ xcb eklentisi bunu ister (yoksa Calamares X'te acilmaz)
libxcb-cursor0
# Calamares dil listesindeki alfabeler kare gorunmesin (Hintce/Marathi, Bengalce, Tamilce,
# Telugu, Malayalam, Sinhala, Tayca); CJK fonts-noto-cjk ile carotos listesinden gelir
fonts-lohit-deva
fonts-lohit-beng-bengali
fonts-lohit-taml
fonts-lohit-telu
fonts-lohit-mlym
fonts-lklug-sinhala
fonts-tlwg-garuda-ttf
# EFI sistem bolumunu bicimlendirmek icin (mkfs.fat)
dosfstools
# NTFS bolumu kucultme/okuma (Windows ile cift acilis)
ntfs-3g
